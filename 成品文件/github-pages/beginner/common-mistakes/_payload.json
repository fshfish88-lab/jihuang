[{"data":1,"prerenderedAt":152},["ShallowReactive",2],{"beginner-common-mistakes":3},{"id":4,"title":5,"aliases":6,"body":10,"category":132,"description":133,"difficulty":132,"english":132,"extension":134,"meta":135,"navigation":136,"path":137,"related":138,"seo":143,"stage":144,"stem":145,"tags":146,"updatedAt":149,"version":150,"__hash__":151},"beginner\u002Fbeginner\u002Fcommon-mistakes.md","新手常见误区",[7,8,9],"新手误区","避坑","为什么总死",{"type":11,"value":12,"toc":120},"minimark",[13,24,29,32,36,50,54,57,61,64,68,81,85,88,91,104,107],[14,15,16],"blockquote",{},[17,18,19,23],"p",{},[20,21,22],"strong",{},"一句话结论："," 新手的大多数失败，不是操作太慢，而是把没有准备的风险拖到了同一时间。",[25,26,28],"h2",{"id":27},"误区一第一天就永久建家","误区一：第一天就永久建家",[17,30,31],{},"探索不足会让基地远离矿区、牛群和关键地形。先获得地图信息，再落地长期建筑。",[25,33,35],{"id":34},"误区二无甲练走位","误区二：无甲练走位",[17,37,38,39,44,45,49],{},"走位是减少伤害，不是拒绝保险。练习时携带",[40,41,43],"a",{"href":42},"\u002Fwiki\u002Flog-suit","木甲","或",[40,46,48],{"href":47},"\u002Fwiki\u002Ffootball-helmet","橄榄球头盔","，失误才有复盘空间。",[25,51,53],{"id":52},"误区三什么都舍不得用","误区三：什么都舍不得用",[17,55,56],{},"食物会腐烂、装备的价值在于降低风险。把恢复食物留到死后没有意义；遇到高压战斗就及时补状态。",[25,58,60],{"id":59},"误区四把-boss-带回家","误区四：把 Boss 带回家",[17,62,63],{},"季节 Boss 会破坏建筑。听到警告后离开核心基地，在预先清理的区域处理。",[25,65,67],{"id":66},"误区五没有复活计划","误区五：没有复活计划",[17,69,70,71,75,76,80],{},"多人世界应准备",[40,72,74],{"href":73},"\u002Fwiki\u002Ftell-tale-heart","告密的心","所需材料；探索到",[40,77,79],{"href":78},"\u002Fwiki\u002Ftouch-stone","试金石","要激活并标记。复活只是重新开始，附近还应留有基础补给。",[25,82,84],{"id":83},"误区六一次带走全部家当","误区六：一次带走全部家当",[17,86,87],{},"洞穴、航海和 Boss 战都可能失败。稀有材料分批带，基地保留备用工具、护甲和光源。",[25,89,90],{"id":90},"自检问题",[92,93,94,98,101],"ul",{},[95,96,97],"li",{},"我现在最大的风险是饥饿、温度、黑暗还是战斗？",[95,99,100],{},"如果这一趟失败，下一次复活后在哪里拿到火源和食物？",[95,102,103],{},"我完成当前目标后，下一步真正需要什么？",[25,105,106],{"id":106},"下一步",[17,108,109,110,114,115,119],{},"回到",[40,111,113],{"href":112},"\u002Fbeginner\u002Ffirst-week","第一周发展路线","或打开",[40,116,118],{"href":117},"\u002Ftools\u002Fprogression-checklist","世界主线任务清单","，只处理当前阶段最关键的两三件事。",{"title":121,"searchDepth":122,"depth":122,"links":123},"",2,[124,125,126,127,128,129,130,131],{"id":27,"depth":122,"text":28},{"id":34,"depth":122,"text":35},{"id":52,"depth":122,"text":53},{"id":59,"depth":122,"text":60},{"id":66,"depth":122,"text":67},{"id":83,"depth":122,"text":84},{"id":90,"depth":122,"text":90},{"id":106,"depth":122,"text":106},null,"不急着永久建家、不囤腐烂食物、不在基地硬接季节 Boss。","md",{},true,"\u002Fbeginner\u002Fcommon-mistakes",[139,140,141,142],"first-day","first-week","tell-tale-heart","touch-stone",{"title":5,"description":133},"随时复查","beginner\u002Fcommon-mistakes",[147,8,148],"新手","复活","2026-07-31","2026.07","ay9fTWThO9LDlb5-I9JleNvjceRZec5rUEwSACQeOF8",1785495330904]