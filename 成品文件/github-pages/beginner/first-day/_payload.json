[{"data":1,"prerenderedAt":142},["ShallowReactive",2],{"beginner-first-day":3},{"id":4,"title":5,"aliases":6,"body":10,"category":122,"description":123,"difficulty":122,"english":122,"extension":124,"meta":125,"navigation":126,"path":127,"related":128,"seo":133,"stage":134,"stem":135,"tags":136,"updatedAt":139,"version":140,"__hash__":141},"beginner\u002Fbeginner\u002Ffirst-day.md","第一天生存路线",[7,8,9],"第一天","开局","新手开荒",{"type":11,"value":12,"toc":112},"minimark",[13,24,28,31,34,50,53,71,74,94,97,100,103],[14,15,16],"blockquote",{},[17,18,19,23],"p",{},[20,21,22],"strong",{},"一句话结论："," 第一天不要急着建家；边走边收集，天黑前留好火把材料，就是合格开局。",[25,26,27],"h2",{"id":27},"当前目标",[17,29,30],{},"在白天结束前获得基础工具、火源和一小份食物，同时沿海岸或道路开始认识地图。",[25,32,33],{"id":33},"准备物品",[35,36,37,41,44,47],"ul",{},[38,39,40],"li",{},"草至少 6 份、树枝至少 6 份；",[38,42,43],{},"燧石 2—3 块；",[38,45,46],{},"随手采集的浆果、胡萝卜或种子；",[38,48,49],{},"火把材料始终留在背包里，不必一开始就做好。",[25,51,52],{"id":52},"操作步骤",[54,55,56,59,62,65,68],"ol",{},[38,57,58],{},"出生后立即观察周围，不在传送门旁长期停留。",[38,60,61],{},"边移动边捡草、树枝和燧石，先做斧头，再根据矿区情况做鹤嘴锄。",[38,63,64],{},"优先沿道路或海岸探图；道路移动更快，海岸能帮你确认地图边界。",[38,66,67],{},"看见矿区、牛群、猪王、沼泽或虫洞时在地图上记住位置，不必立刻处理。",[38,69,70],{},"黄昏后检查草和树枝。视野仍安全时继续走，接近黑夜再放营火或点火把。",[25,72,73],{"id":73},"常见错误",[35,75,76,82,88],{},[38,77,78,81],{},[20,79,80],{},"出生点立刻建家："," 你还不知道关键资源在哪里，往后每天都会付出交通成本。",[38,83,84,87],{},[20,85,86],{},"把草和树枝全部做成工具："," 没有火把材料时，黑夜会直接结束这一局。",[38,89,90,93],{},[20,91,92],{},"为了捡一件东西进入沼泽："," 第一天没有护甲，触手和鱼人都不值得冒险。",[25,95,96],{"id":96},"完成标志",[17,98,99],{},"你已经活过第一个夜晚，背包里还有基础材料，并且地图上出现了一段清晰的探索路线。",[25,101,102],{"id":102},"下一步",[17,104,105,106,111],{},"继续阅读",[107,108,110],"a",{"href":109},"\u002Fbeginner\u002Ffirst-week","第一周发展路线","，目标是找到金块、完成第一层科技，并在了解资源分布后再决定建家位置。",{"title":113,"searchDepth":114,"depth":114,"links":115},"",2,[116,117,118,119,120,121],{"id":27,"depth":114,"text":27},{"id":33,"depth":114,"text":33},{"id":52,"depth":114,"text":52},{"id":73,"depth":114,"text":73},{"id":96,"depth":114,"text":96},{"id":102,"depth":114,"text":102},null,"从出生到点燃第一堆火，按顺序完成最重要的四件事。","md",{},true,"\u002Fbeginner\u002Ffirst-day",[129,130,131,132],"torch","campfire","science-machine","first-week",{"title":5,"description":123},"第 1 天","beginner\u002Ffirst-day",[137,8,138],"新手","探索","2026-07-31","2026.07","ng1alNNWlcrEI5Teeg7AX_NCbGFqcasA26cOEKc7Lpc",1785483019014]