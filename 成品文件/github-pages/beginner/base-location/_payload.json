[{"data":1,"prerenderedAt":146},["ShallowReactive",2],{"beginner-base-location":3},{"id":4,"title":5,"aliases":6,"body":10,"category":126,"description":127,"difficulty":126,"english":126,"extension":128,"meta":129,"navigation":130,"path":131,"related":132,"seo":137,"stage":138,"stem":139,"tags":140,"updatedAt":143,"version":144,"__hash__":145},"beginner\u002Fbeginner\u002Fbase-location.md","建家选址不踩坑",[7,8,9],"建家","基地选址","家建哪里",{"type":11,"value":12,"toc":117},"minimark",[13,24,28,56,59,62,65,68,89,92,95,98],[14,15,16],"blockquote",{},[17,18,19,23],"p",{},[20,21,22],"strong",{},"一句话结论："," 好基地让你每天少走路，也让危险离核心建筑更远。",[25,26,27],"h2",{"id":27},"选址看四件事",[29,30,31,38,44,50],"ol",{},[32,33,34,37],"li",{},[20,35,36],{},"交通："," 靠近道路、虫洞或重要航线，往返成本低。",[32,39,40,43],{},[20,41,42],{},"食物："," 附近有可迁移资源或稳定猎物，但不用贴着所有资源建。",[32,45,46,49],{},[20,47,48],{},"燃料与材料："," 木材、草、树枝和矿物可以在合理时间内补充。",[32,51,52,55],{},[20,53,54],{},"安全："," 不要紧贴沼泽触手、杀人蜂区、频繁战斗点或会拆家的目标。",[25,57,58],{"id":58},"推荐做法",[17,60,61],{},"先用一个营火和少量箱子建立临时落脚点，再用两三天验证路线。如果去矿区、牛群、食物区都需要长途折返，就应尽早调整，而不是继续堆建筑。",[17,63,64],{},"核心建筑之间留出扩展空间。烹饪区、储物区、种植区和战斗区不必挤成一团；季节 Boss 来临时，优先把它引离基地再处理。",[25,66,67],{"id":67},"不建议照搬的说法",[69,70,71,77,83],"ul",{},[32,72,73,76],{},[20,74,75],{},"“一定要建在地图中心”："," 世界生成不同，几何中心未必交通便利。",[32,78,79,82],{},[20,80,81],{},"“一定贴着牛群”："," 牛群发情期有危险，过近也会限制空间。",[32,84,85,88],{},[20,86,87],{},"“资源越多越好”："," 低频资源不值得每天经过，高频路线才影响体验。",[25,90,91],{"id":91},"完成标志",[17,93,94],{},"从基地出发能在短时间内获得食物、燃料和常用材料；危险不会直接刷在核心建筑旁；基地仍有清晰扩展空间。",[25,96,97],{"id":97},"下一步",[17,99,100,101,106,107,111,112,116],{},"建造",[102,103,105],"a",{"href":104},"\u002Fwiki\u002Falchemy-engine","炼金引擎","、",[102,108,110],{"href":109},"\u002Fwiki\u002Fcrock-pot","烹饪锅","和",[102,113,115],{"href":114},"\u002Fwiki\u002Fice-box","冰箱","，开始为冬季建立食物与燃料库存。",{"title":118,"searchDepth":119,"depth":119,"links":120},"",2,[121,122,123,124,125],{"id":27,"depth":119,"text":27},{"id":58,"depth":119,"text":58},{"id":67,"depth":119,"text":67},{"id":91,"depth":119,"text":91},{"id":97,"depth":119,"text":97},null,"用资源半径和交通成本判断基地位置，而不是只看地面是否漂亮。","md",{},true,"\u002Fbeginner\u002Fbase-location",[133,134,135,136],"first-week","alchemy-engine","crock-pot","ice-box",{"title":5,"description":127},"第 5—10 天","beginner\u002Fbase-location",[141,7,142],"新手","资源","2026-07-31","2026.07","r-N6NQ-e8ezMyEszogx3y1T9mH6V2JyaZMNiO-Idtjo",1785495330608]