[{"data":1,"prerenderedAt":174},["ShallowReactive",2],{"beginner-first-week":3},{"id":4,"title":5,"aliases":6,"body":10,"category":152,"description":153,"difficulty":152,"english":152,"extension":154,"meta":155,"navigation":156,"path":157,"related":158,"seo":164,"stage":165,"stem":166,"tags":167,"updatedAt":171,"version":172,"__hash__":173},"beginner\u002Fbeginner\u002Ffirst-week.md","第一周发展路线",[7,8,9],"第一周","七天攻略","前期发展",{"type":11,"value":12,"toc":138},"minimark",[13,24,28,31,34,39,48,52,55,74,82,86,99,102,116,119,122,125],[14,15,16],"blockquote",{},[17,18,19,23],"p",{},[20,21,22],"strong",{},"一句话结论："," 第一周最值钱的不是漂亮基地，而是一张知道金块、食物、牛群和关键地形在哪里的地图。",[25,26,27],"h2",{"id":27},"当前目标",[17,29,30],{},"完成主要区域探索，制作科学机器并原型关键装备，最后选一个交通便利的位置建立第一版基地。",[25,32,33],{"id":33},"推荐节奏",[35,36,38],"h3",{"id":37},"第-12-天保证工具与火源","第 1—2 天：保证工具与火源",[17,40,41,42,47],{},"按",[43,44,46],"a",{"href":45},"\u002Fbeginner\u002Ffirst-day","第一天路线","收集材料，保持移动。路上采集的食物足以支撑探索，不需要为了种田停下。",[35,49,51],{"id":50},"第-35-天寻找关键资源","第 3—5 天：寻找关键资源",[17,53,54],{},"至少确认：",[56,57,58,62,65,68,71],"ul",{},[59,60,61],"li",{},"有金矿的岩石区；",[59,63,64],{},"适合获得粪肥和牛毛的牛群；",[59,66,67],{},"蜘蛛巢、猪屋或其他基础战斗资源；",[59,69,70],{},"沼泽、落叶林、沙漠等特殊区域；",[59,72,73],{},"可持续取得食物和木材的区域。",[17,75,76,77,81],{},"找到金块后建造",[43,78,80],{"href":79},"\u002Fwiki\u002Fscience-machine","科学机器","，原型背包、长矛、木甲等物品。原型完成后可以拆除临时科技点或继续探索。",[35,83,85],{"id":84},"第-57-天落下第一版基地","第 5—7 天：落下第一版基地",[17,87,88,89,93,94,98],{},"基地不必处在所有资源正中央，但要让高频路线短：食物、木材、虫洞或道路应容易抵达。建造",[43,90,92],{"href":91},"\u002Fwiki\u002Falchemy-engine","炼金引擎","、",[43,95,97],{"href":96},"\u002Fwiki\u002Fcrock-pot","烹饪锅","和基础储物区。",[25,100,101],{"id":101},"常见错误",[56,103,104,107,110,113],{},[59,105,106],{},"只沿地图内部乱走，始终不知道世界边界；",[59,108,109],{},"把稀有食物囤到腐烂，却没有形成料理循环；",[59,111,112],{},"为了“完美基地”拖到冬季前仍没有稳定科技和燃料；",[59,114,115],{},"没有护甲就主动处理蜘蛛群或沼泽战斗。",[25,117,118],{"id":118},"完成标志",[17,120,121],{},"地图已出现多个关键资源点；基地有炼金引擎、烹饪锅和基础储物；你知道接下来如何获得食物、燃料与护甲。",[25,123,124],{"id":124},"下一步",[17,126,127,128,132,133,137],{},"检查",[43,129,131],{"href":130},"\u002Fbeginner\u002Fbase-location","建家选址","，然后按",[43,134,136],{"href":135},"\u002Fbeginner\u002Ffirst-winter","第一个冬季准备","开始收集保暖与燃料。",{"title":139,"searchDepth":140,"depth":140,"links":141},"",2,[142,143,149,150,151],{"id":27,"depth":140,"text":27},{"id":33,"depth":140,"text":33,"children":144},[145,147,148],{"id":37,"depth":146,"text":38},3,{"id":50,"depth":146,"text":51},{"id":84,"depth":146,"text":85},{"id":101,"depth":140,"text":101},{"id":118,"depth":140,"text":118},{"id":124,"depth":140,"text":124},null,"先探索，再建家，用七天建立稳定食物与基础科技。","md",{},true,"\u002Fbeginner\u002Ffirst-week",[159,160,161,162,163],"first-day","science-machine","alchemy-engine","crock-pot","base-location",{"title":5,"description":153},"第 1—7 天","beginner\u002Ffirst-week",[168,169,170],"新手","科技","探索","2026-07-31","2026.07","EHN6scGaP2HBB8NNq6XBwUkdDIUAwndOBC0x-LHmHCk",1785495330593]