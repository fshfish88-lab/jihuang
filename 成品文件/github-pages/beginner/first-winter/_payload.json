[{"data":1,"prerenderedAt":160},["ShallowReactive",2],{"beginner-first-winter":3},{"id":4,"title":5,"aliases":6,"body":10,"category":140,"description":141,"difficulty":140,"english":140,"extension":142,"meta":143,"navigation":144,"path":145,"related":146,"seo":151,"stage":152,"stem":153,"tags":154,"updatedAt":157,"version":158,"__hash__":159},"beginner\u002Fbeginner\u002Ffirst-winter.md","第一个冬季准备",[7,8,9],"冬天","过冬","第一个冬季",{"type":11,"value":12,"toc":125},"minimark",[13,24,28,32,41,44,52,55,58,61,64,67,86,89,103,106,109,112],[14,15,16],"blockquote",{},[17,18,19,23],"p",{},[20,21,22],"strong",{},"一句话结论："," 冬季不是靠一块暖石硬扛；保暖装备、可加热位置、食物与巨鹿预案要同时准备。",[25,26,27],"h2",{"id":27},"四项清单",[29,30,31],"h3",{"id":31},"保暖",[17,33,34,35,40],{},"至少准备",[36,37,39],"a",{"href":38},"\u002Fwiki\u002Fthermal-stone","暖石","和一件可靠保暖装备。暖石会逐渐变冷，出门前要充分加热，远行路线也要知道在哪里重新取暖。",[29,42,43],{"id":43},"食物",[17,45,46,47,51],{},"冬季采集效率下降，提前建立烹饪锅和冰箱。准备稳定主食，并留出",[36,48,50],{"href":49},"\u002Fwiki\u002Fpierogi","波兰水饺","等恢复料理的食材。",[29,53,54],{"id":54},"燃料",[17,56,57],{},"把木材、草和其他燃料分散储存。不要把全部燃料留到最后几天才砍；冬季赶工会同时承受寒冷和饥饿。",[29,59,60],{"id":60},"独眼巨鹿预案",[17,62,63],{},"听到明显警告声后，带好护甲、武器、恢复、照明和火源，离开基地核心。你可以选择战斗、利用其他生物，或把它引到远离建筑的区域拖过当晚。",[25,65,66],{"id":66},"新手推荐配置",[68,69,70,74,77,80,83],"ul",{},[71,72,73],"li",{},"暖石与保暖帽；",[71,75,76],{},"两套以上可替换护甲；",[71,78,79],{},"火腿棒或其他可靠武器；",[71,81,82],{},"一组主食与数份恢复；",[71,84,85],{},"火把、营火材料和应急复活手段。",[25,87,88],{"id":88},"常见失败原因",[68,90,91,94,97,100],{},[71,92,93],{},"暖石冷却后继续远行，没有第二个取暖点；",[71,95,96],{},"为了追猎物离基地太远，黄昏后同时缺光和缺温度；",[71,98,99],{},"巨鹿出现时留在锅、冰箱和箱子旁战斗；",[71,101,102],{},"护甲只带一件，破损后继续硬接攻击。",[25,104,105],{"id":105},"完成标志",[17,107,108],{},"你能持续取暖、进食和补充燃料；巨鹿出现时有明确集合点与处理路线。",[25,110,111],{"id":111},"下一步",[17,113,114,115,119,120,124],{},"冬季稳定后可以挑战",[36,116,118],{"href":117},"\u002Fbosses\u002Fdeerclops","独眼巨鹿","、寻找克劳斯，或开始准备",[36,121,123],{"href":122},"\u002Fprogression\u002Fcaves-ruins","洞穴与遗迹线","。",{"title":126,"searchDepth":127,"depth":127,"links":128},"",2,[129,136,137,138,139],{"id":27,"depth":127,"text":27,"children":130},[131,133,134,135],{"id":31,"depth":132,"text":31},3,{"id":43,"depth":132,"text":43},{"id":54,"depth":132,"text":54},{"id":60,"depth":132,"text":60},{"id":66,"depth":127,"text":66},{"id":88,"depth":127,"text":88},{"id":105,"depth":127,"text":105},{"id":111,"depth":127,"text":111},null,"保暖、食物、燃料和巨鹿预案四项齐备，冬天就不再是倒计时。","md",{},true,"\u002Fbeginner\u002Ffirst-winter",[147,148,149,150],"thermal-stone","beefalo-hat","deerclops","pierogi",{"title":5,"description":141},"第 11—20 天","beginner\u002Ffirst-winter",[155,31,156],"冬季","Boss","2026-07-31","2026.07","Qba93LHlsltDhsdQMwkCnRFpM3ssqDqm_Q6fmWNSXn0",1785495330622]