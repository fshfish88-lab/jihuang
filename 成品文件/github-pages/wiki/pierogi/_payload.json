[{"data":1,"prerenderedAt":78},["ShallowReactive",2],{"wiki-pierogi":3},{"id":4,"title":5,"aliases":6,"body":9,"category":56,"description":57,"difficulty":58,"english":59,"extension":60,"meta":61,"navigation":62,"path":63,"related":64,"seo":69,"stage":70,"stem":71,"tags":72,"updatedAt":75,"version":76,"__hash__":77},"wiki\u002Fwiki\u002Fpierogi.md","波兰水饺",[7,5,8],"饺子","pierogi",{"type":10,"value":11,"toc":48},"minimark",[12,23,27,30,33,36,39,42,45],[13,14,15],"blockquote",{},[16,17,18,22],"p",{},[19,20,21],"strong",{},"一句话说明："," 水饺是可靠的战斗恢复储备，价值在于提前做好，而不是挨打后才找材料。",[24,25,26],"h2",{"id":26},"如何获得",[16,28,29],{},"在烹饪锅中使用符合要求的蛋、肉、蔬菜和填充物组合。",[24,31,32],{"id":32},"什么时候需要",[16,34,35],{},"季节 Boss、洞穴远征、航海和任何无法靠自然恢复解决的高压战斗。",[24,37,38],{"id":38},"是否值得制作",[16,40,41],{},"很值得。按每次任务分装，基地保留下一次战斗所需的食材。",[24,43,44],{"id":44},"常见误区",[16,46,47],{},"把全部水饺带在一个玩家身上；低血量仍不吃；配方材料被日常主食全部消耗。",{"title":49,"searchDepth":50,"depth":50,"links":51},"",2,[52,53,54,55],{"id":26,"depth":50,"text":26},{"id":32,"depth":50,"text":32},{"id":38,"depth":50,"text":38},{"id":44,"depth":50,"text":44},"食物","常用战斗恢复料理；提前备好蛋、肉和蔬菜比临战找食材可靠。",null,"Pierogi","md",{},true,"\u002Fwiki\u002Fpierogi",[65,66,67,68],"crock-pot","bee-queen","klaus","wolfgang",{"title":5,"description":57},"中期","wiki\u002Fpierogi",[56,73,74],"恢复","战斗","2026-07-31","2026.07","sVAPsJ96YSJr1UizkzmtUHqgCJnL-S_uTuBkAmCVbyo",1785483019645]