[{"data":1,"prerenderedAt":77},["ShallowReactive",2],{"wiki-thermal-stone":3},{"id":4,"title":5,"aliases":6,"body":9,"category":56,"description":57,"difficulty":58,"english":59,"extension":60,"meta":61,"navigation":62,"path":63,"related":64,"seo":68,"stage":69,"stem":70,"tags":71,"updatedAt":74,"version":75,"__hash__":76},"wiki\u002Fwiki\u002Fthermal-stone.md","暖石",[5,7,8],"热能石","thermal stone",{"type":10,"value":11,"toc":48},"minimark",[12,23,27,30,33,36,39,42,45],[13,14,15],"blockquote",{},[16,17,18,22],"p",{},[19,20,21],"strong",{},"一句话说明："," 暖石是移动温度缓冲，不是“带上就不会冷”的永久护盾。",[24,25,26],"h2",{"id":26},"如何获得",[16,28,29],{},"在相应科技下使用石材等常见材料制作，并靠近足够热的火源加热。",[24,31,32],{"id":32},"什么时候需要",[16,34,35],{},"冬季远行、夜间降温和从一个取暖点移动到下一个取暖点。",[24,37,38],{"id":38},"是否值得制作",[16,40,41],{},"值得，但必须配合保暖装备、火源与路线规划。",[24,43,44],{"id":44},"常见误区",[16,46,47],{},"暖石已冷却仍继续远行；过度加热时忽视周围起火风险；只准备暖石而没有牛帽或其他保暖手段。",{"title":49,"searchDepth":50,"depth":50,"links":51},"",2,[52,53,54,55],{"id":26,"depth":50,"text":26},{"id":32,"depth":50,"text":32},{"id":38,"depth":50,"text":38},{"id":44,"depth":50,"text":44},"物品","帮助管理温度，但不是无限热源；搭配保暖装备和定期加热更稳。",null,"Thermal Stone","md",{},true,"\u002Fwiki\u002Fthermal-stone",[65,66,67],"first-winter","beefalo-hat","campfire",{"title":5,"description":57},"冬季前","wiki\u002Fthermal-stone",[56,72,73],"保暖","冬季","2026-07-31","2026.07","sBcLveTLHC9m0l_NNTPnwqCHbz4QuFM1k10plsu2Zvk",1785483019607]