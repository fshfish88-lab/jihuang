[{"data":1,"prerenderedAt":77},["ShallowReactive",2],{"wiki-science-machine":3},{"id":4,"title":5,"aliases":6,"body":9,"category":56,"description":57,"difficulty":58,"english":59,"extension":60,"meta":61,"navigation":62,"path":63,"related":64,"seo":68,"stage":69,"stem":70,"tags":71,"updatedAt":74,"version":75,"__hash__":76},"wiki\u002Fwiki\u002Fscience-machine.md","科学机器",[5,7,8],"一本","science machine",{"type":10,"value":11,"toc":48},"minimark",[12,23,27,30,33,36,39,42,45],[13,14,15],"blockquote",{},[16,17,18,22],"p",{},[19,20,21],"strong",{},"一句话说明："," 科学机器的价值是完成关键原型，不是把你固定在第一个金矿旁。",[24,25,26],"h2",{"id":26},"如何获得",[16,28,29],{},"收集金块、木材和石头后建造。矿区、墓地或猪王交易都可能帮助取得金块。",[24,31,32],{"id":32},"主要用途",[16,34,35],{},"解锁背包、长矛、木甲等基础原型，为后续探索和基地建设做准备。",[24,37,38],{"id":38},"什么时候需要",[16,40,41],{},"通常在开局数天内完成。可以先建临时科技点，再在选定基地建造更高层科技。",[24,43,44],{"id":44},"常见误区",[16,46,47],{},"为了保护临时科学机器停止探索；原型还没做完就离开；在危险区附近长时间整理科技菜单。",{"title":49,"searchDepth":50,"depth":50,"links":51},"",2,[52,53,54,55],{"id":26,"depth":50,"text":26},{"id":32,"depth":50,"text":32},{"id":38,"depth":50,"text":38},{"id":44,"depth":50,"text":44},"建筑","解锁第一层科技；原型制作后即可继续探索，不必把它当永久基地。",null,"Science Machine","md",{},true,"\u002Fwiki\u002Fscience-machine",[65,66,67],"first-week","alchemy-engine","basic-survival",{"title":5,"description":57},"第 1—3 天","wiki\u002Fscience-machine",[56,72,73],"科技","开局","2026-07-31","2026.07","xopr0REIMJfg9nQoKbrZZzQZhHyJWF3-HHlP5RwFudw",1785483019418]