[{"data":1,"prerenderedAt":78},["ShallowReactive",2],{"wiki-football-helmet":3},{"id":4,"title":5,"aliases":6,"body":9,"category":56,"description":57,"difficulty":58,"english":59,"extension":60,"meta":61,"navigation":62,"path":63,"related":64,"seo":69,"stage":70,"stem":71,"tags":72,"updatedAt":75,"version":76,"__hash__":77},"wiki\u002Fwiki\u002Ffootball-helmet.md","橄榄球头盔",[7,5,8],"猪皮帽","football helmet",{"type":10,"value":11,"toc":48},"minimark",[12,23,27,30,33,36,39,42,45],[13,14,15],"blockquote",{},[16,17,18,22],"p",{},[19,20,21],"strong",{},"一句话说明："," 头盔让你保留背包栏，是最适合新手常备的通用护甲之一。",[24,25,26],"h2",{"id":26},"如何获得",[16,28,29],{},"在相应科技下使用猪皮和绳索制作，建立稳定猪皮来源后可以批量准备。",[24,31,32],{"id":32},"什么时候需要",[16,34,35],{},"猎犬来袭、蜘蛛清理、洞穴探索与大多数 Boss 战。",[24,37,38],{"id":38},"是否值得制作",[16,40,41],{},"非常值得。正式战斗不要只带一顶，耐久耗尽时要能立即更换。",[24,43,44],{"id":44},"常见误区",[16,46,47],{},"头盔损坏后没有察觉；把全部备用护甲放在远处箱子里；认为穿甲就可以无视攻击前摇。",{"title":49,"searchDepth":50,"depth":50,"links":51},"",2,[52,53,54,55],{"id":26,"depth":50,"text":26},{"id":32,"depth":50,"text":32},{"id":38,"depth":50,"text":38},{"id":44,"depth":50,"text":44},"装备","耐用且通用的头部护甲，是新手练习走位时最可靠的保险。",null,"Football Helmet","md",{},true,"\u002Fwiki\u002Ffootball-helmet",[65,66,67,68],"deerclops","bee-queen","wolfgang","wigfrid",{"title":5,"description":57},"前中期","wiki\u002Ffootball-helmet",[56,73,74],"护甲","战斗","2026-07-31","2026.07","To2WvRb5B5q-TGdVCiboR-lM_bhSjdIlNfiIgOYiihs",1785483019571]