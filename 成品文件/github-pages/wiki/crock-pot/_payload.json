[{"data":1,"prerenderedAt":78},["ShallowReactive",2],{"wiki-crock-pot":3},{"id":4,"title":5,"aliases":6,"body":9,"category":56,"description":57,"difficulty":58,"english":59,"extension":60,"meta":61,"navigation":62,"path":63,"related":64,"seo":69,"stage":70,"stem":71,"tags":72,"updatedAt":75,"version":76,"__hash__":77},"wiki\u002Fwiki\u002Fcrock-pot.md","烹饪锅",[5,7,8],"锅","crock pot",{"type":10,"value":11,"toc":48},"minimark",[12,23,27,30,33,36,39,42,45],[13,14,15],"blockquote",{},[16,17,18,22],"p",{},[19,20,21],"strong",{},"一句话说明："," 烹饪锅的核心价值是把食材变成“可预测结果”，而不是让任何四样东西都更值钱。",[24,25,26],"h2",{"id":26},"如何获得",[16,28,29],{},"完成所需科技后，使用木炭、树枝和石材等材料制作。",[24,31,32],{"id":32},"主要用途",[16,34,35],{},"制作肉丸、波兰水饺等稳定料理，分别解决饱食和战斗恢复。",[24,37,38],{"id":38},"什么时候需要",[16,40,41],{},"第一周建立基地时优先制作。只有锅而没有食材来源和储存仍无法形成循环。",[24,43,44],{"id":44},"常见误区",[16,46,47],{},"不了解配方优先级就投入稀有食材；锅太少导致团队等待；成品长期留在锅里而没有按计划取用。",{"title":49,"searchDepth":50,"depth":50,"links":51},"",2,[52,53,54,55],{"id":26,"depth":50,"text":26},{"id":32,"depth":50,"text":32},{"id":38,"depth":50,"text":38},{"id":44,"depth":50,"text":44},"建筑","把零散食材转化为稳定料理，是第一周最值得建设的食物设施。",null,"Crock Pot","md",{},true,"\u002Fwiki\u002Fcrock-pot",[65,66,67,68],"first-week","meatballs","pierogi","ice-box",{"title":5,"description":57},"第一周","wiki\u002Fcrock-pot",[56,73,74],"料理","基地","2026-07-31","2026.07","IEVjHGI0IsyXFy2waVbSS0X7DEcmWoDCHD0UeS1_08o",1785483019438]