[{"data":1,"prerenderedAt":77},["ShallowReactive",2],{"wiki-pig-king":3},{"id":4,"title":5,"aliases":6,"body":9,"category":56,"description":57,"difficulty":58,"english":59,"extension":60,"meta":61,"navigation":62,"path":63,"related":64,"seo":68,"stage":69,"stem":70,"tags":71,"updatedAt":74,"version":75,"__hash__":76},"wiki\u002Fwiki\u002Fpig-king.md","猪王",[5,7,8],"pig king","换金子",{"type":10,"value":11,"toc":48},"minimark",[12,23,27,30,33,36,39,42,45],[13,14,15],"blockquote",{},[16,17,18,22],"p",{},[19,20,21],"strong",{},"一句话说明："," 猪王是可重复的金块来源之一，价值来自长期交易路线。",[24,25,26],"h2",{"id":26},"如何找到",[16,28,29],{},"通常在对应聚落区域，通过探索落叶林等地形发现并标记。",[24,31,32],{"id":32},"主要用途",[16,34,35],{},"用合适物品交换金块，缓解基地科技和装备的金块需求。",[24,37,38],{"id":38},"什么时候需要",[16,40,41],{},"开局缺金、清理墓穴物品后，或中期需要批量科技材料时。",[24,43,44],{"id":44},"常见误区",[16,46,47],{},"带着不接受的物品长途往返；没有标记道路；在附近惹怒猪人后仍停留整理物资。",{"title":49,"searchDepth":50,"depth":50,"links":51},"",2,[52,53,54,55],{"id":26,"depth":50,"text":26},{"id":32,"depth":50,"text":32},{"id":38,"depth":50,"text":38},{"id":44,"depth":50,"text":44},"生物","用特定物品换取金块的重要资源点，前期探索发现后应标记。",null,"Pig King","md",{},true,"\u002Fwiki\u002Fpig-king",[65,66,67],"first-week","science-machine","basic-survival",{"title":5,"description":57},"探索期","wiki\u002Fpig-king",[56,72,73],"资源","地表","2026-07-31","2026.07","ASo0aWJwibzYlUm6r79paQE4cCkuLWnWvt2DKDAmEB4",1785483019736]