[{"data":1,"prerenderedAt":78},["ShallowReactive",2],{"wiki-hambat":3},{"id":4,"title":5,"aliases":6,"body":9,"category":56,"description":57,"difficulty":58,"english":59,"extension":60,"meta":61,"navigation":62,"path":63,"related":64,"seo":69,"stage":70,"stem":71,"tags":72,"updatedAt":75,"version":76,"__hash__":77},"wiki\u002Fwiki\u002Fhambat.md","火腿棒",[5,7,8],"火腿棍","hambat",{"type":10,"value":11,"toc":48},"minimark",[12,23,27,30,33,36,39,42,45],[13,14,15],"blockquote",{},[16,17,18,22],"p",{},[19,20,21],"strong",{},"一句话说明："," 火腿棒适合把一段时间内的多场战斗集中处理，别让它在箱子里变旧。",[24,25,26],"h2",{"id":26},"如何获得",[16,28,29],{},"在相应科技下使用肉类与猪皮等材料制作。",[24,31,32],{"id":32},"什么时候需要",[16,34,35],{},"季节 Boss、洞穴远征或连续资源战斗前，越新鲜越适合高压目标。",[24,37,38],{"id":38},"是否值得制作",[16,40,41],{},"战斗安排明确时很值得；如果最近不打架，提前制作会浪费新鲜度。",[24,43,44],{"id":44},"常见误区",[16,46,47],{},"制作后长期不用；只带武器不带备用护甲；在无法稳定输出的战斗中把理论伤害当成实际收益。",{"title":49,"searchDepth":50,"depth":50,"links":51},"",2,[52,53,54,55],{"id":26,"depth":50,"text":26},{"id":32,"depth":50,"text":32},{"id":38,"depth":50,"text":38},{"id":44,"depth":50,"text":44},"武器","不消耗耐久但会随新鲜度降低伤害，适合连续战斗窗口。",null,"Ham Bat","md",{},true,"\u002Fwiki\u002Fhambat",[65,66,67,68],"deerclops","bearger","wolfgang","wigfrid",{"title":5,"description":57},"中期战斗","wiki\u002Fhambat",[56,73,74],"战斗","Boss","2026-07-31","2026.07","mPV87w_GpofzoZGtEyqbcCOYh40vcL9NYbSOPFq_8GY",1785483019594]