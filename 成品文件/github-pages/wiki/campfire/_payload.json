[{"data":1,"prerenderedAt":77},["ShallowReactive",2],{"wiki-campfire":3},{"id":4,"title":5,"aliases":6,"body":9,"category":56,"description":57,"difficulty":58,"english":59,"extension":60,"meta":61,"navigation":62,"path":63,"related":64,"seo":68,"stage":69,"stem":70,"tags":71,"updatedAt":74,"version":75,"__hash__":76},"wiki\u002Fwiki\u002Fcampfire.md","营火",[5,7,8],"篝火","campfire",{"type":10,"value":11,"toc":48},"minimark",[12,23,27,30,33,36,39,42,45],[13,14,15],"blockquote",{},[16,17,18,22],"p",{},[19,20,21],"strong",{},"一句话说明："," 营火解决今晚，不替你决定家建在哪里。",[24,25,26],"h2",{"id":26},"主要用途",[16,28,29],{},"提供固定区域照明、烹饪基础食材并帮助安全度过夜晚。",[24,31,32],{"id":32},"什么时候需要",[16,34,35],{},"第一晚或远行临时落脚。长期基地可以规划更稳定的火源和燃料区。",[24,37,38],{"id":38},"是否值得制作",[16,40,41],{},"开局值得，但不要看到第一堆营火就开始永久建家。",[24,43,44],{"id":44},"常见误区",[16,46,47],{},"燃料用尽后站在黑暗里整理背包；把临时营火周围堆满稀有物品；误把火光范围当作战斗安全区。",{"title":49,"searchDepth":50,"depth":50,"links":51},"",2,[52,53,54,55],{"id":26,"depth":50,"text":26},{"id":32,"depth":50,"text":32},{"id":38,"depth":50,"text":38},{"id":44,"depth":50,"text":44},"建筑","提供夜间照明和烹饪；临时探索时够用，不等于永久基地。",null,"Campfire","md",{},true,"\u002Fwiki\u002Fcampfire",[65,66,67],"first-day","torch","base-location",{"title":5,"description":57},"第 1 天","wiki\u002Fcampfire",[56,72,73],"照明","开局","2026-07-31","2026.07","lEGtklfuy5GcTLfFLuFxihSWh4cBa5XiPu2znNSYazw",1785483019408]