[{"data":1,"prerenderedAt":77},["ShallowReactive",2],{"wiki-alchemy-engine":3},{"id":4,"title":5,"aliases":6,"body":9,"category":56,"description":57,"difficulty":58,"english":59,"extension":60,"meta":61,"navigation":62,"path":63,"related":64,"seo":68,"stage":69,"stem":70,"tags":71,"updatedAt":74,"version":75,"__hash__":76},"wiki\u002Fwiki\u002Falchemy-engine.md","炼金引擎",[5,7,8],"二本","alchemy engine",{"type":10,"value":11,"toc":48},"minimark",[12,23,27,30,33,36,39,42,45],[13,14,15],"blockquote",{},[16,17,18,22],"p",{},[19,20,21],"strong",{},"一句话说明："," 炼金引擎代表基地进入前中期，但科技站本身不会替你提供食物和安全。",[24,25,26],"h2",{"id":26},"如何获得",[16,28,29],{},"在完成基础科技后收集木板、石砖与电器元件等材料，于长期基地建造。",[24,31,32],{"id":32},"主要用途",[16,34,35],{},"解锁大量前中期工具、装备和建筑，是季节准备与远行装备的核心。",[24,37,38],{"id":38},"什么时候需要",[16,40,41],{},"第一周左右、基地位置基本确定后。拖得太晚会挤压冬季准备时间。",[24,43,44],{"id":44},"常见误区",[16,46,47],{},"只建科技不建食物循环；把科技站放在战斗缓冲区；解锁配方后没有准备原材料库存。",{"title":49,"searchDepth":50,"depth":50,"links":51},"",2,[52,53,54,55],{"id":26,"depth":50,"text":26},{"id":32,"depth":50,"text":32},{"id":38,"depth":50,"text":38},{"id":44,"depth":50,"text":44},"建筑","稳定基地的核心科技站，解锁大部分前中期工具与装备。",null,"Alchemy Engine","md",{},true,"\u002Fwiki\u002Falchemy-engine",[65,66,67],"first-week","base-location","science-machine",{"title":5,"description":57},"第 5—10 天","wiki\u002Falchemy-engine",[56,72,73],"科技","基地","2026-07-31","2026.07","XczaNp1spCicEqCHrS-eoPYMIUOaX4SKiD6wcWdbysY",1785483019428]