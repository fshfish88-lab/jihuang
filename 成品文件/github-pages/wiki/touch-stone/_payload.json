[{"data":1,"prerenderedAt":77},["ShallowReactive",2],{"wiki-touch-stone":3},{"id":4,"title":5,"aliases":6,"body":9,"category":56,"description":57,"difficulty":58,"english":59,"extension":60,"meta":61,"navigation":62,"path":63,"related":64,"seo":68,"stage":69,"stem":70,"tags":71,"updatedAt":74,"version":75,"__hash__":76},"wiki\u002Fwiki\u002Ftouch-stone.md","试金石",[5,7,8],"复活台","touch stone",{"type":10,"value":11,"toc":48},"minimark",[12,23,27,30,33,36,39,42,45],[13,14,15],"blockquote",{},[16,17,18,22],"p",{},[19,20,21],"strong",{},"一句话说明："," 找到试金石就激活并标记，但复活后仍需要就近补给。",[24,25,26],"h2",{"id":26},"如何获得",[16,28,29],{},"试金石由世界生成，探索发现后与其互动激活。",[24,31,32],{"id":32},"什么时候需要",[16,34,35],{},"角色死亡后作为复活选择，尤其适合单人世界的风险缓冲。",[24,37,38],{"id":38},"是否值得处理",[16,40,41],{},"值得立刻标记。附近可留下火把、基础食物和简单装备，但不要堆放全部稀有物资。",[24,43,44],{"id":44},"常见误区",[16,46,47],{},"看到却不激活；复活后不知道基地方向；试金石周围没有任何夜间生存材料。",{"title":49,"searchDepth":50,"depth":50,"links":51},"",2,[52,53,54,55],{"id":26,"depth":50,"text":26},{"id":32,"depth":50,"text":32},{"id":38,"depth":50,"text":38},{"id":44,"depth":50,"text":44},"建筑","探索时激活并标记位置，为单人和团队保留一次重要的复活选择。",null,"Touch Stone","md",{},true,"\u002Fwiki\u002Ftouch-stone",[65,66,67],"common-mistakes","tell-tale-heart","first-week",{"title":5,"description":57},"探索期","wiki\u002Ftouch-stone",[56,72,73],"复活","探索","2026-07-31","2026.07","djojjl4VfBbgG3RdQydq9cHpq8I9sDa75dT52YjGss4",1785483019723]