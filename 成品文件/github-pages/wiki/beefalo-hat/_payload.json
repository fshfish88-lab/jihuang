[{"data":1,"prerenderedAt":77},["ShallowReactive",2],{"wiki-beefalo-hat":3},{"id":4,"title":5,"aliases":6,"body":9,"category":56,"description":57,"difficulty":58,"english":59,"extension":60,"meta":61,"navigation":62,"path":63,"related":64,"seo":68,"stage":69,"stem":70,"tags":71,"updatedAt":74,"version":75,"__hash__":76},"wiki\u002Fwiki\u002Fbeefalo-hat.md","牛帽",[5,7,8],"牛角帽","beefalo hat",{"type":10,"value":11,"toc":48},"minimark",[12,23,27,30,33,36,39,42,45],[13,14,15],"blockquote",{},[16,17,18,22],"p",{},[19,20,21],"strong",{},"一句话说明："," 牛帽提供可靠保暖，是第一个冬季最直观的安全投资之一。",[24,25,26],"h2",{"id":26},"如何获得",[16,28,29],{},"准备牛毛与牛角等材料后，在相应科技下制作。接近牛群时注意发情期风险。",[24,31,32],{"id":32},"什么时候需要",[16,34,35],{},"冬季远行、夜间工作和处理需要长时间离开火源的目标。",[24,37,38],{"id":38},"是否值得制作",[16,40,41],{},"很值得，与暖石组合能明显增加安全活动时间。",[24,43,44],{"id":44},"常见误区",[16,46,47],{},"为了取材料在发情期贴近牛群；只有帽子没有可重复加热的路线；把耐久耗尽的装备留到紧急时。",{"title":49,"searchDepth":50,"depth":50,"links":51},"",2,[52,53,54,55],{"id":26,"depth":50,"text":26},{"id":32,"depth":50,"text":32},{"id":38,"depth":50,"text":38},{"id":44,"depth":50,"text":44},"装备","优秀的冬季保暖帽，制作前需要规划牛毛与牛角来源。",null,"Beefalo Hat","md",{},true,"\u002Fwiki\u002Fbeefalo-hat",[65,66,67],"first-winter","thermal-stone","beefalo",{"title":5,"description":57},"冬季前","wiki\u002Fbeefalo-hat",[56,72,73],"保暖","冬季","2026-07-31","2026.07","inajY1nRz63bp7Lo9kJg4ZuZSLquWj7WToVTovs9l88",1785483019621]