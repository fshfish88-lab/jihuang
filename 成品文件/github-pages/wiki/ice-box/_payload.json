[{"data":1,"prerenderedAt":78},["ShallowReactive",2],{"wiki-ice-box":3},{"id":4,"title":5,"aliases":6,"body":9,"category":56,"description":57,"difficulty":58,"english":59,"extension":60,"meta":61,"navigation":62,"path":63,"related":64,"seo":69,"stage":70,"stem":71,"tags":72,"updatedAt":75,"version":76,"__hash__":77},"wiki\u002Fwiki\u002Fice-box.md","冰箱",[5,7,8],"ice box","保鲜",{"type":10,"value":11,"toc":48},"minimark",[12,23,27,30,33,36,39,42,45],[13,14,15],"blockquote",{},[16,17,18,22],"p",{},[19,20,21],"strong",{},"一句话说明："," 冰箱延缓腐烂，不会让没有计划的囤积自动变成食物循环。",[24,25,26],"h2",{"id":26},"如何获得",[16,28,29],{},"需要齿轮等材料，通常在探索机械生物或其他来源后建造。",[24,31,32],{"id":32},"主要用途",[16,34,35],{},"储存生鲜食材和待使用料理，减少季节与远行造成的浪费。",[24,37,38],{"id":38},"什么时候需要",[16,40,41],{},"基地已有烹饪锅并开始稳定积累食材时。",[24,43,44],{"id":44},"常见误区",[16,46,47],{},"把所有食物混在同一个冰箱；不检查新鲜度；为囤积低价值食材消耗全部有限齿轮。",{"title":49,"searchDepth":50,"depth":50,"links":51},"",2,[52,53,54,55],{"id":26,"depth":50,"text":26},{"id":32,"depth":50,"text":32},{"id":38,"depth":50,"text":38},{"id":44,"depth":50,"text":44},"建筑","延长多数食物保质期；齿轮有限时优先服务稳定食物循环。",null,"Ice Box","md",{},true,"\u002Fwiki\u002Fice-box",[65,66,67,68],"first-week","crock-pot","meatballs","pierogi",{"title":5,"description":57},"第一周","wiki\u002Fice-box",[56,73,74],"食物","基地","2026-07-31","2026.07","lKn98avt_5AbUGBqnqAFxxa0PLl_gSFyTnFUmw9bqsY",1785483019446]