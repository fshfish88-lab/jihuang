[{"data":1,"prerenderedAt":77},["ShallowReactive",2],{"wiki-healing-salve":3},{"id":4,"title":5,"aliases":6,"body":9,"category":56,"description":57,"difficulty":58,"english":59,"extension":60,"meta":61,"navigation":62,"path":63,"related":64,"seo":68,"stage":69,"stem":70,"tags":71,"updatedAt":74,"version":75,"__hash__":76},"wiki\u002Fwiki\u002Fhealing-salve.md","治疗药膏",[5,7,8],"药膏","healing salve",{"type":10,"value":11,"toc":48},"minimark",[12,23,27,30,33,36,39,42,45],[13,14,15],"blockquote",{},[16,17,18,22],"p",{},[19,20,21],"strong",{},"一句话说明："," 药膏适合应急和分散补给，不能替代战斗前的护甲准备。",[24,25,26],"h2",{"id":26},"如何获得",[16,28,29],{},"收集蜘蛛腺体、灰烬和石材等材料后制作。",[24,31,32],{"id":32},"什么时候需要",[16,34,35],{},"洞穴、航海、团队分组探索和回不到烹饪锅的短期任务。",[24,37,38],{"id":38},"是否值得制作",[16,40,41],{},"有稳定蜘蛛资源时值得常备少量，尤其适合放在地下补给点。",[24,43,44],{"id":44},"常见误区",[16,46,47],{},"不穿护甲却大量消耗药膏；所有恢复集中在基地；战斗中站在危险范围内使用。",{"title":49,"searchDepth":50,"depth":50,"links":51},"",2,[52,53,54,55],{"id":26,"depth":50,"text":26},{"id":32,"depth":50,"text":32},{"id":38,"depth":50,"text":38},{"id":44,"depth":50,"text":44},"物品","材料直观的应急恢复，适合洞穴或远行时分散携带。",null,"Healing Salve","md",{},true,"\u002Fwiki\u002Fhealing-salve",[65,66,67],"common-mistakes","caves-ruins","football-helmet",{"title":5,"description":57},"前中期","wiki\u002Fhealing-salve",[56,72,73],"恢复","远行","2026-07-31","2026.07","r1w8jFerqhEd4zSa9GttYkwVX821SvBMismJqdlW7Xo",1785483019657]