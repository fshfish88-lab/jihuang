[{"data":1,"prerenderedAt":77},["ShallowReactive",2],{"wiki-log-suit":3},{"id":4,"title":5,"aliases":6,"body":9,"category":56,"description":57,"difficulty":58,"english":59,"extension":60,"meta":61,"navigation":62,"path":63,"related":64,"seo":68,"stage":69,"stem":70,"tags":71,"updatedAt":74,"version":75,"__hash__":76},"wiki\u002Fwiki\u002Flog-suit.md","木甲",[5,7,8],"木头盔甲","log suit",{"type":10,"value":11,"toc":48},"minimark",[12,23,27,30,33,36,39,42,45],[13,14,15],"blockquote",{},[16,17,18,22],"p",{},[19,20,21],"strong",{},"一句话说明："," 木甲便宜可靠，但穿上后会占用身体栏；战斗前要整理背包位置。",[24,25,26],"h2",{"id":26},"如何获得",[16,28,29],{},"完成基础科技后使用木材与绳索制作。",[24,31,32],{"id":32},"什么时候需要",[16,34,35],{},"开局练习战斗、临时猎犬袭击、尚未稳定获得头盔材料时。",[24,37,38],{"id":38},"是否值得制作",[16,40,41],{},"值得作为早期保险和备用护甲，尤其适合风险不高的短战斗。",[24,43,44],{"id":44},"常见误区",[16,46,47],{},"开战后才发现背包落在危险位置；把护甲耐久打空；穿木甲时仍携带不必要的整包物资。",{"title":49,"searchDepth":50,"depth":50,"links":51},"",2,[52,53,54,55],{"id":26,"depth":50,"text":26},{"id":32,"depth":50,"text":32},{"id":38,"depth":50,"text":38},{"id":44,"depth":50,"text":44},"装备","材料直接、适合紧急战斗；会占用身体栏，准备背包切换意识。",null,"Log Suit","md",{},true,"\u002Fwiki\u002Flog-suit",[65,66,67],"first-day","common-mistakes","football-helmet",{"title":5,"description":57},"前期","wiki\u002Flog-suit",[56,72,73],"护甲","战斗","2026-07-31","2026.07","XxIrwoQLxcnFBKN8h6OjupW-QwdyyHuzcDcHkwMIbgE",1785483019583]