[{"data":1,"prerenderedAt":77},["ShallowReactive",2],{"wiki-lantern":3},{"id":4,"title":5,"aliases":6,"body":9,"category":56,"description":57,"difficulty":58,"english":59,"extension":60,"meta":61,"navigation":62,"path":63,"related":64,"seo":68,"stage":69,"stem":70,"tags":71,"updatedAt":74,"version":75,"__hash__":76},"wiki\u002Fwiki\u002Flantern.md","提灯",[5,7,8],"灯笼","lantern",{"type":10,"value":11,"toc":48},"minimark",[12,23,27,30,33,36,39,42,45],[13,14,15],"blockquote",{},[16,17,18,22],"p",{},[19,20,21],"strong",{},"一句话说明："," 提灯最大的优势是能放在地上持续照明，让你在地下使用武器和工具。",[24,25,26],"h2",{"id":26},"如何获得",[16,28,29],{},"进入洞穴后收集对应发光资源，在相应科技下制作并用同类资源补充。",[24,31,32],{"id":32},"什么时候需要",[16,34,35],{},"地下补给点、遗迹战斗和需要双手操作的长时间工作。",[24,37,38],{"id":38},"是否值得制作",[16,40,41],{},"洞穴路线必备。正式远征至少准备一盏主灯和一份备用照明。",[24,43,44],{"id":44},"常见误区",[16,46,47],{},"把唯一提灯落在战场；没有补充燃料；只顾地面灯光，离开范围后进入黑暗。",{"title":49,"searchDepth":50,"depth":50,"links":51},"",2,[52,53,54,55],{"id":26,"depth":50,"text":26},{"id":32,"depth":50,"text":32},{"id":38,"depth":50,"text":38},{"id":44,"depth":50,"text":44},"物品","洞穴核心可充能光源；放在地上也能照明，解放手部装备栏。",null,"Lantern","md",{},true,"\u002Fwiki\u002Flantern",[65,66,67],"caves-ruins","miner-hat","ancient-guardian",{"title":5,"description":57},"洞穴准备","wiki\u002Flantern",[56,72,73],"照明","洞穴","2026-07-31","2026.07","_9-gOvCbNBxhl1p4WzHE-QsT4TtkD8r4CGX9Bbq7J8I",1785483019669]