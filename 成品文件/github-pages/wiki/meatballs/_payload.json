[{"data":1,"prerenderedAt":77},["ShallowReactive",2],{"wiki-meatballs":3},{"id":4,"title":5,"aliases":6,"body":9,"category":56,"description":57,"difficulty":58,"english":59,"extension":60,"meta":61,"navigation":62,"path":63,"related":64,"seo":68,"stage":69,"stem":70,"tags":71,"updatedAt":74,"version":75,"__hash__":76},"wiki\u002Fwiki\u002Fmeatballs.md","肉丸",[5,7,8],"meatballs","丸子",{"type":10,"value":11,"toc":48},"minimark",[12,23,27,30,33,36,39,42,45],[13,14,15],"blockquote",{},[16,17,18,22],"p",{},[19,20,21],"strong",{},"一句话说明："," 肉丸主要解决饱食，不是战斗恢复药；便宜填充物越稳定，价值越高。",[24,25,26],"h2",{"id":26},"如何获得",[16,28,29],{},"在烹饪锅中使用少量肉类配合合适填充物制作，注意不要触发其他高优先级配方。",[24,31,32],{"id":32},"什么时候需要",[16,34,35],{},"开荒、远行和团队日常主食。",[24,37,38],{"id":38},"是否值得制作",[16,40,41],{},"非常适合新手，但稀有肉和高价值食材不应只为了做肉丸而浪费。",[24,43,44],{"id":44},"常见误区",[16,46,47],{},"把肉丸当主要回血食物；不了解填充物限制；一次做太多却没有冰箱保存。",{"title":49,"searchDepth":50,"depth":50,"links":51},"",2,[52,53,54,55],{"id":26,"depth":50,"text":26},{"id":32,"depth":50,"text":32},{"id":38,"depth":50,"text":38},{"id":44,"depth":50,"text":44},"食物","配方宽松的饱食料理，适合把少量肉和便宜填充物变成稳定口粮。",null,"Meatballs","md",{},true,"\u002Fwiki\u002Fmeatballs",[65,66,67],"crock-pot","first-week","wigfrid",{"title":5,"description":57},"第一周","wiki\u002Fmeatballs",[56,72,73],"料理","新手","2026-07-31","2026.07","_2OuTR9cc6JHDGSRhAXCDehr5w2c6hatyMzgmCOCb-o",1785483019633]