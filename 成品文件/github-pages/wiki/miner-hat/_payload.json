[{"data":1,"prerenderedAt":77},["ShallowReactive",2],{"wiki-miner-hat":3},{"id":4,"title":5,"aliases":6,"body":9,"category":56,"description":57,"difficulty":58,"english":59,"extension":60,"meta":61,"navigation":62,"path":63,"related":64,"seo":68,"stage":69,"stem":70,"tags":71,"updatedAt":74,"version":75,"__hash__":76},"wiki\u002Fwiki\u002Fminer-hat.md","矿工帽",[7,5,8],"矿灯帽","miner hat",{"type":10,"value":11,"toc":48},"minimark",[12,23,27,30,33,36,39,42,45],[13,14,15],"blockquote",{},[16,17,18,22],"p",{},[19,20,21],"strong",{},"一句话说明："," 矿工帽适合移动探索，提灯适合固定战斗；两者不是完全替代关系。",[24,25,26],"h2",{"id":26},"如何获得",[16,28,29],{},"在相应科技下使用草帽、金块和发光材料等制作。",[24,31,32],{"id":32},"什么时候需要",[16,34,35],{},"边走边采集、追踪地图路径和需要频繁移动的洞穴任务。",[24,37,38],{"id":38},"是否值得制作",[16,40,41],{},"值得，与提灯搭配能覆盖移动与固定照明两种需求。",[24,43,44],{"id":44},"常见误区",[16,46,47],{},"只带矿工帽却没有头部护甲切换；耐久接近耗尽仍深入；战斗时忘记照明与防护占用同一栏位。",{"title":49,"searchDepth":50,"depth":50,"links":51},"",2,[52,53,54,55],{"id":26,"depth":50,"text":26},{"id":32,"depth":50,"text":32},{"id":38,"depth":50,"text":38},{"id":44,"depth":50,"text":44},"装备","头部照明让双手保持可用，探索洞穴和夜间采集很方便。",null,"Miner Hat","md",{},true,"\u002Fwiki\u002Fminer-hat",[65,66,67],"caves-ruins","lantern","ancient-guardian",{"title":5,"description":57},"洞穴准备","wiki\u002Fminer-hat",[56,72,73],"照明","洞穴","2026-07-31","2026.07","93C99t6hVo_WOeai4vV3-Jt9qbs6KR4KaIQiH1hKHG0",1785483019682]