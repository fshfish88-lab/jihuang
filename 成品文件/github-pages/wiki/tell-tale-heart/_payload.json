[{"data":1,"prerenderedAt":78},["ShallowReactive",2],{"wiki-tell-tale-heart":3},{"id":4,"title":5,"aliases":6,"body":10,"category":57,"description":58,"difficulty":59,"english":60,"extension":61,"meta":62,"navigation":63,"path":64,"related":65,"seo":69,"stage":70,"stem":71,"tags":72,"updatedAt":75,"version":76,"__hash__":77},"wiki\u002Fwiki\u002Ftell-tale-heart.md","告密的心",[7,8,5,9],"心","复活心","telltale heart",{"type":11,"value":12,"toc":49},"minimark",[13,24,28,31,34,37,40,43,46],[14,15,16],"blockquote",{},[17,18,19,23],"p",{},[20,21,22],"strong",{},"一句话说明："," 告密的心解决“重新站起来”，不解决复活后的低状态和物资丢失。",[25,26,27],"h2",{"id":27},"如何获得",[17,29,30],{},"多人世界中使用草和蜘蛛腺体等材料制作，制作者会承担生命代价。",[25,32,33],{"id":33},"什么时候需要",[17,35,36],{},"队友死亡且附近没有更合适的复活方式时。",[25,38,39],{"id":39},"是否值得制作",[17,41,42],{},"多人队伍应保持材料储备，但不必提前制作大量成品。",[25,44,45],{"id":45},"常见误区",[17,47,48],{},"复活点没有火源和食物；连续救人导致施救者状态过低；没先把危险生物引开就原地复活。",{"title":50,"searchDepth":51,"depth":51,"links":52},"",2,[53,54,55,56],{"id":27,"depth":51,"text":27},{"id":33,"depth":51,"text":33},{"id":39,"depth":51,"text":39},{"id":45,"depth":51,"text":45},"物品","多人模式的常见救援手段；复活会带来代价，救起后要继续恢复状态。",null,"Telltale Heart","md",{},true,"\u002Fwiki\u002Ftell-tale-heart",[66,67,68],"common-mistakes","touch-stone","first-day",{"title":5,"description":58},"多人开局","wiki\u002Ftell-tale-heart",[57,73,74],"复活","多人","2026-07-31","2026.07","6w5YtxNNhKGhOxwhAdF9j9zNF22swt3b2B2Kdd7Hzzc",1785483019711]