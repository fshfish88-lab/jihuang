[{"data":1,"prerenderedAt":77},["ShallowReactive",2],{"wiki-beefalo":3},{"id":4,"title":5,"aliases":6,"body":9,"category":56,"description":57,"difficulty":58,"english":59,"extension":60,"meta":61,"navigation":62,"path":63,"related":64,"seo":68,"stage":69,"stem":70,"tags":71,"updatedAt":74,"version":75,"__hash__":76},"wiki\u002Fwiki\u002Fbeefalo.md","皮弗娄牛",[7,5,8],"牛","beefalo",{"type":10,"value":11,"toc":48},"minimark",[12,23,27,30,33,36,39,42,45],[13,14,15],"blockquote",{},[16,17,18,22],"p",{},[19,20,21],"strong",{},"一句话说明："," 牛群是重要资源点，但“靠近资源”不等于“把基地贴在牛群旁”。",[24,25,26],"h2",{"id":26},"主要用途",[16,28,29],{},"提供粪肥、牛毛和牛角相关资源，也能影响部分战斗与驯化路线。",[24,31,32],{"id":32},"什么时候需要",[16,34,35],{},"第一周标记位置；冬季前准备牛帽；需要粪肥或后续驯化时反复利用。",[24,37,38],{"id":38},"是否适合贴近建家",[16,40,41],{},"不建议过近。发情期和牛群移动会给基地带来额外风险。",[24,43,44],{"id":44},"常见误区",[16,46,47],{},"发情期靠得太近；为了取牛毛没有准备安全方案；把所有牛群引到同一区域。",{"title":49,"searchDepth":50,"depth":50,"links":51},"",2,[52,53,54,55],{"id":26,"depth":50,"text":26},{"id":32,"depth":50,"text":32},{"id":38,"depth":50,"text":38},{"id":44,"depth":50,"text":44},"生物","提供粪肥、牛毛与牛角相关资源；发情期需要保持距离。",null,"Beefalo","md",{},true,"\u002Fwiki\u002Fbeefalo",[65,66,67],"first-week","beefalo-hat","base-location",{"title":5,"description":57},"探索期","wiki\u002Fbeefalo",[56,72,73],"资源","地表","2026-07-31","2026.07","CATw0GCIMIA65VI4WMT7R__LfYn2GhDrn314MsS7V68",1785483019748]