[{"data":1,"prerenderedAt":234},["ShallowReactive",2],{"character-wx-78":3},{"id":4,"title":5,"aliases":6,"body":11,"category":211,"description":212,"difficulty":203,"english":5,"extension":213,"meta":214,"navigation":215,"path":216,"related":217,"seo":223,"stage":224,"stem":225,"tags":226,"updatedAt":231,"version":232,"__hash__":233},"characters\u002Fcharacters\u002Fwx-78.md","WX-78",[7,8,9,10],"wx","wx78","机器人","铁皮人",{"type":12,"value":13,"toc":193},"minimark",[14,25,29,89,92,95,98,101,104,108,111,114,117,120,123,126,129,132,148,152,161,164,175,178],[15,16,17],"blockquote",{},[18,19,20,24],"p",{},[21,22,23],"strong",{},"一句话评价："," WX-78 的强度来自“为当前任务换对电路”，而不是把所有升级都当成永久堆叠。",[26,27,28],"h2",{"id":28},"角色速览",[30,31,32,45],"table",{},[33,34,35],"thead",{},[36,37,38,42],"tr",{},[39,40,41],"th",{},"项目",[39,43,44],{},"结论",[46,47,48,57,65,73,81],"tbody",{},[36,49,50,54],{},[51,52,53],"td",{},"定位",[51,55,56],{},"成长、任务适配",[36,58,59,62],{},[51,60,61],{},"上手难度",[51,63,64],{},"中高",[36,66,67,70],{},[51,68,69],{},"新手推荐",[51,71,72],{},"中",[36,74,75,78],{},[51,76,77],{},"适合模式",[51,79,80],{},"单人 \u002F 多人",[36,82,83,86],{},[51,84,85],{},"核心资源",[51,87,88],{},"电路与电力管理",[26,90,91],{"id":91},"核心机制",[18,93,94],{},"电路让 WX-78 能针对移动、照明、战斗或资源任务调整能力。你需要先明确这次出门要做什么，再决定模块；频繁无目标更换只会消耗时间和资源。",[26,96,97],{"id":97},"开局路线",[18,99,100],{},"仍先完成标准探图和科技。第一周不要为了追求完整电路体系耽误食物与冬季准备。等基地能稳定供给，再逐步收集扫描与升级需要的资源。",[26,102,103],{"id":103},"四阶段建议",[105,106,107],"h3",{"id":107},"开局",[18,109,110],{},"保证基础生存，记录适合扫描或后续利用的生物位置。",[105,112,113],{"id":113},"建家",[18,115,116],{},"建立电路整理区，将当前装备与备用模块分开存放，避免临时找不到。",[105,118,119],{"id":119},"中期",[18,121,122],{},"洞穴探索可以围绕照明和移动能力配置；航海则更重视持续补给与返程。",[105,124,125],{"id":125},"后期",[18,127,128],{},"针对大型 Boss 或资源任务做专用配置，完成后再换回日常组合。",[26,130,131],{"id":131},"玩法方案",[133,134,135,142],"ul",{},[136,137,138,141],"li",{},[21,139,140],{},"单人成长流："," 先通用生存，再逐步建立任务化模块库。",[136,143,144,147],{},[21,145,146],{},"团队专职流："," 根据队伍缺口选择移动、探索或战斗方向，减少重复劳动。",[26,149,151],{"id":150},"boss-表现","Boss 表现",[18,153,154,155,160],{},"只要配置和装备正确，WX-78 能适应多数战斗，但角色模块不能替代",[156,157,159],"a",{"href":158},"\u002Fwiki\u002Ffootball-helmet","橄榄球头盔","和恢复料理。",[26,162,163],{"id":163},"常见误区",[133,165,166,169,172],{},[136,167,168],{},"开局只追电路，忽略季节进度；",[136,170,171],{},"模块搭配与任务无关，只选看起来强的组合；",[136,173,174],{},"远行没有备用照明和返程计划。",[26,176,177],{"id":177},"相关条目",[18,179,180,184,185,184,189],{},[156,181,183],{"href":182},"\u002Fwiki\u002Flantern","提灯"," · ",[156,186,188],{"href":187},"\u002Fwiki\u002Fboat-kit","船套装",[156,190,192],{"href":191},"\u002Fprogression\u002Flunar-island","月岛与天体线",{"title":194,"searchDepth":195,"depth":195,"links":196},"",2,[197,198,199,200,207,208,209,210],{"id":28,"depth":195,"text":28},{"id":91,"depth":195,"text":91},{"id":97,"depth":195,"text":97},{"id":103,"depth":195,"text":103,"children":201},[202,204,205,206],{"id":107,"depth":203,"text":107},3,{"id":113,"depth":203,"text":113},{"id":119,"depth":203,"text":119},{"id":125,"depth":203,"text":125},{"id":131,"depth":195,"text":131},{"id":150,"depth":195,"text":151},{"id":163,"depth":195,"text":163},{"id":177,"depth":195,"text":177},null,"通过电路成长并适应不同任务，强大但需要理解模块组合。","md",{},true,"\u002Fcharacters\u002Fwx-78",[218,219,220,221,222],"first-week","caves-ruins","lunar-island","lantern","boat-kit",{"title":5,"description":212},"机制进阶","characters\u002Fwx-78",[227,228,229,230],"成长","资源","单人","复杂机制","2026-07-31","2026.07","MBTec3BYtWFPA0GT5dEQmtF0uRu4CatWSFSsofHJmLQ",1785495330700]