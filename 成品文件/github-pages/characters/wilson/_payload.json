[{"data":1,"prerenderedAt":239},["ShallowReactive",2],{"character-wilson":3},{"id":4,"title":5,"aliases":6,"body":9,"category":214,"description":215,"difficulty":216,"english":217,"extension":218,"meta":219,"navigation":220,"path":221,"related":222,"seo":228,"stage":229,"stem":230,"tags":231,"updatedAt":236,"version":237,"__hash__":238},"characters\u002Fcharacters\u002Fwilson.md","威尔逊",[7,8,5],"wilson","科学家",{"type":10,"value":11,"toc":196},"minimark",[12,23,27,87,90,93,96,105,108,112,115,118,121,124,127,130,133,136,152,156,164,167,178,181],[13,14,15],"blockquote",{},[16,17,18,22],"p",{},[19,20,21],"strong",{},"一句话评价："," 如果你想先学会“世界怎么玩”，而不是先记一套角色资源，威尔逊是最稳的起点。",[24,25,26],"h2",{"id":26},"角色速览",[28,29,30,43],"table",{},[31,32,33],"thead",{},[34,35,36,40],"tr",{},[37,38,39],"th",{},"项目",[37,41,42],{},"结论",[44,45,46,55,63,71,79],"tbody",{},[34,47,48,52],{},[49,50,51],"td",{},"定位",[49,53,54],{},"通用生存、学习世界",[34,56,57,60],{},[49,58,59],{},"上手难度",[49,61,62],{},"低",[34,64,65,68],{},[49,66,67],{},"新手推荐",[49,69,70],{},"很高",[34,72,73,76],{},[49,74,75],{},"适合模式",[49,77,78],{},"单人 \u002F 多人",[34,80,81,84],{},[49,82,83],{},"主要缺点",[49,85,86],{},"缺少极端爆发和团队专属优势",[24,88,89],{"id":89},"核心机制",[16,91,92],{},"威尔逊的优势在于稳定和直观。你不需要围绕特殊食谱或强制资源改变整个开局，可以把注意力放在探图、科技、季节和战斗节奏上。胡须相关能力能提供额外的生存选择，但不要把它当作忽略保暖装备的理由。",[24,94,95],{"id":95},"开局路线",[16,97,98,99,104],{},"按",[100,101,103],"a",{"href":102},"\u002Fbeginner\u002Ffirst-day","第一天生存路线","探索。优先完成基础工具和科学机器原型，再根据地图确定基地。威尔逊没有必须争抢的特殊资源，因此很适合承担队伍里的通用探索与补缺。",[24,106,107],{"id":107},"四阶段建议",[109,110,111],"h3",{"id":111},"开局",[16,113,114],{},"保持移动，完成探图和基础科技。不要因为角色“标准”就囤积所有材料；把背包留给当前路线需要的东西。",[109,116,117],{"id":117},"建家",[16,119,120],{},"搭建炼金引擎、烹饪锅和储物区，帮助团队建立可重复的资源循环。",[109,122,123],{"id":123},"中期",[16,125,126],{},"根据世界需要切换工作：洞穴照明、季节准备、航海或 Boss 物资。标准角色的价值就是不被单一任务绑住。",[109,128,129],{"id":129},"后期",[16,131,132],{},"用技能方向和装备弥补团队缺口。面对 Boss 时仍以护甲、恢复和走位为核心，不依赖角色被动硬接。",[24,134,135],{"id":135},"玩法方案",[137,138,139,146],"ul",{},[140,141,142,145],"li",{},[19,143,144],{},"新手稳定流："," 通用装备、稳定料理、按世界主线推进。",[140,147,148,151],{},[19,149,150],{},"多人补位流："," 负责探索、科技原型和缺口物资，不与专精角色抢同一工作。",[24,153,155],{"id":154},"boss-表现","Boss 表现",[16,157,158,159,163],{},"面对",[100,160,162],{"href":161},"\u002Fbosses\u002Fdeerclops","独眼巨鹿","等常规 Boss 时表现稳定，但不会替你省掉准备。至少携带可靠武器、多套护甲、恢复食物和照明。",[24,165,166],{"id":166},"常见误区",[137,168,169,172,175],{},[140,170,171],{},"认为“无明显缺点”等于“可以不做准备”；",[140,173,174],{},"为了利用胡须机制忽略保暖与复活；",[140,176,177],{},"中后期没有根据团队需要调整分工。",[24,179,180],{"id":180},"相关条目",[16,182,183,187,188,187,192],{},[100,184,186],{"href":185},"\u002Fwiki\u002Fscience-machine","科学机器"," · ",[100,189,191],{"href":190},"\u002Fwiki\u002Fthermal-stone","暖石",[100,193,195],{"href":194},"\u002Fprogression\u002Fbasic-survival","基础生存线",{"title":197,"searchDepth":198,"depth":198,"links":199},"",2,[200,201,202,203,210,211,212,213],{"id":26,"depth":198,"text":26},{"id":89,"depth":198,"text":89},{"id":95,"depth":198,"text":95},{"id":107,"depth":198,"text":107,"children":204},[205,207,208,209],{"id":111,"depth":206,"text":111},3,{"id":117,"depth":206,"text":117},{"id":123,"depth":206,"text":123},{"id":129,"depth":206,"text":129},{"id":135,"depth":198,"text":135},{"id":154,"depth":198,"text":155},{"id":166,"depth":198,"text":166},{"id":180,"depth":198,"text":180},null,"机制直观、没有致命短板，适合用来学习世界本身。",1,"Wilson","md",{},true,"\u002Fcharacters\u002Fwilson",[223,224,225,226,227],"first-day","basic-survival","deerclops","science-machine","thermal-stone",{"title":5,"description":215},"新手入门","characters\u002Fwilson",[232,233,234,235],"新手友好","通用","单人","多人","2026-07-31","2026.07","rMyo3wfeB8BeJVVfc7KySjoRvjyunMRnBbd3vB3CF3g",1785495330630]