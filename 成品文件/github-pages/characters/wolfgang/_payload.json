[{"data":1,"prerenderedAt":237},["ShallowReactive",2],{"character-wolfgang":3},{"id":4,"title":5,"aliases":6,"body":10,"category":214,"description":215,"difficulty":206,"english":216,"extension":217,"meta":218,"navigation":219,"path":220,"related":221,"seo":227,"stage":228,"stem":229,"tags":230,"updatedAt":234,"version":235,"__hash__":236},"characters\u002Fcharacters\u002Fwolfgang.md","沃尔夫冈",[7,5,8,9],"wolfgang","大力士","大力",{"type":11,"value":12,"toc":196},"minimark",[13,24,28,87,90,93,96,99,102,106,109,112,115,118,121,124,127,130,146,150,164,167,178,181],[14,15,16],"blockquote",{},[17,18,19,23],"p",{},[20,21,22],"strong",{},"一句话评价："," 沃尔夫冈会放大正确的战斗准备，但力量优势不能替代护甲、恢复和走位。",[25,26,27],"h2",{"id":27},"角色速览",[29,30,31,44],"table",{},[32,33,34],"thead",{},[35,36,37,41],"tr",{},[38,39,40],"th",{},"项目",[38,42,43],{},"结论",[45,46,47,56,64,71,79],"tbody",{},[35,48,49,53],{},[50,51,52],"td",{},"定位",[50,54,55],{},"正面战斗、Boss 输出",[35,57,58,61],{},[50,59,60],{},"上手难度",[50,62,63],{},"中",[35,65,66,69],{},[50,67,68],{},"新手推荐",[50,70,63],{},[35,72,73,76],{},[50,74,75],{},"适合模式",[50,77,78],{},"单人 \u002F 多人",[35,80,81,84],{},[50,82,83],{},"核心管理",[50,85,86],{},"力量状态与补给",[25,88,89],{"id":89},"核心机制",[17,91,92],{},"沃尔夫冈需要围绕力量状态安排训练与战斗窗口。高状态适合集中处理 Boss，低状态时不要勉强开战。真正的收益来自“把准备好的输出窗口压缩得更短”，不是盲目站桩。",[25,94,95],{"id":95},"开局路线",[17,97,98],{},"前几天仍按标准开局探图。稳定食物和基础装备后，再专门安排力量管理。不要因为角色战斗强就跳过地图、科技或食物循环。",[25,100,101],{"id":101},"四阶段建议",[103,104,105],"h3",{"id":105},"开局",[17,107,108],{},"优先保证主食和基础护甲，避免把宝贵时间全部花在无意义的小怪战斗。",[103,110,111],{"id":111},"建家",[17,113,114],{},"建立能够支持力量和恢复的食物循环，准备火腿棒和橄榄球头盔。",[103,116,117],{"id":117},"中期",[17,119,120],{},"承担季节 Boss 与洞穴高威胁目标，但开战前把撤退路线和备用护甲放到位。",[103,122,123],{"id":123},"后期",[17,125,126],{},"与团队统一爆发窗口。先处理机制，再输出；不要为了保持伤害而忽视即将到来的范围攻击。",[25,128,129],{"id":129},"玩法方案",[131,132,133,140],"ul",{},[134,135,136,139],"li",{},[20,137,138],{},"单人 Boss 流："," 预先堆好护甲、恢复和力量状态，一次处理明确目标。",[134,141,142,145],{},[20,143,144],{},"团队输出流："," 由队友负责控制、清杂或补给，自己集中在安全输出窗口。",[25,147,149],{"id":148},"boss-表现","Boss 表现",[17,151,152,153,158,159,163],{},"对",[154,155,157],"a",{"href":156},"\u002Fbosses\u002Fdeerclops","独眼巨鹿","和",[154,160,162],{"href":161},"\u002Fbosses\u002Fancient-guardian","远古守护者","都有优秀输出，但地下战斗必须保证照明。",[25,165,166],{"id":166},"常见误区",[131,168,169,172,175],{},[134,170,171],{},"低状态时临时决定打 Boss；",[134,173,174],{},"只带一件护甲，输出过程中装备破损；",[134,176,177],{},"为了多打一击忽视攻击前摇。",[25,179,180],{"id":180},"相关条目",[17,182,183,187,188,187,192],{},[154,184,186],{"href":185},"\u002Fwiki\u002Fhambat","火腿棒"," · ",[154,189,191],{"href":190},"\u002Fwiki\u002Ffootball-helmet","橄榄球头盔",[154,193,195],{"href":194},"\u002Fwiki\u002Fpierogi","波兰水饺",{"title":197,"searchDepth":198,"depth":198,"links":199},"",2,[200,201,202,203,210,211,212,213],{"id":27,"depth":198,"text":27},{"id":89,"depth":198,"text":89},{"id":95,"depth":198,"text":95},{"id":101,"depth":198,"text":101,"children":204},[205,207,208,209],{"id":105,"depth":206,"text":105},3,{"id":111,"depth":206,"text":111},{"id":117,"depth":206,"text":117},{"id":123,"depth":206,"text":123},{"id":129,"depth":198,"text":129},{"id":148,"depth":198,"text":149},{"id":166,"depth":198,"text":166},{"id":180,"depth":198,"text":180},null,"依靠力量值获得直接战斗收益，适合愿意练习走位的玩家。","Wolfgang","md",{},true,"\u002Fcharacters\u002Fwolfgang",[222,223,224,225,226],"deerclops","ancient-guardian","hambat","football-helmet","pierogi",{"title":5,"description":215},"战斗进阶","characters\u002Fwolfgang",[231,232,233],"战斗","单人","Boss","2026-07-31","2026.07","_v92vj6eDpkGGQ3RvWNKYT3TC6q4hjTOmbgdnFzYFPE",1785495330680]