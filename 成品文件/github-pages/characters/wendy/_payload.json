[{"data":1,"prerenderedAt":233},["ShallowReactive",2],{"character-wendy":3},{"id":4,"title":5,"aliases":6,"body":10,"category":208,"description":209,"difficulty":210,"english":211,"extension":212,"meta":213,"navigation":214,"path":215,"related":216,"seo":222,"stage":223,"stem":224,"tags":225,"updatedAt":230,"version":231,"__hash__":232},"characters\u002Fcharacters\u002Fwendy.md","温蒂",[7,5,8,9],"wendy","妹妹","阿比盖尔",{"type":11,"value":12,"toc":190},"minimark",[13,24,28,87,90,93,96,99,102,106,109,112,115,118,121,124,127,130,146,150,158,161,172,175],[14,15,16],"blockquote",{},[17,18,19,23],"p",{},[20,21,22],"strong",{},"一句话评价："," 温蒂能把蜘蛛、青蛙等成群小怪从“高风险战斗”变成“可管理资源”，但大型 Boss 仍需要正常走位。",[25,26,27],"h2",{"id":27},"角色速览",[29,30,31,44],"table",{},[32,33,34],"thead",{},[35,36,37,41],"tr",{},[38,39,40],"th",{},"项目",[38,42,43],{},"结论",[45,46,47,56,64,72,80],"tbody",{},[35,48,49,53],{},[50,51,52],"td",{},"定位",[50,54,55],{},"群体战斗、采集辅助",[35,57,58,61],{},[50,59,60],{},"上手难度",[50,62,63],{},"低",[35,65,66,69],{},[50,67,68],{},"新手推荐",[50,70,71],{},"很高",[35,73,74,77],{},[50,75,76],{},"适合模式",[50,78,79],{},"单人 \u002F 多人",[35,81,82,85],{},[50,83,84],{},"核心伙伴",[50,86,9],{},[25,88,89],{"id":89},"核心机制",[17,91,92],{},"阿比盖尔擅长持续范围伤害，能有效处理蜘蛛、蜜蜂等小型群体。你要学会控制她何时参与战斗、何时召回，以及避免让她在不合适的目标前持续承伤。",[25,94,95],{"id":95},"开局路线",[17,97,98],{},"完成基础采集后，可以更早处理小型蜘蛛巢，获得怪物肉、蛛网和腺体。即使有阿比盖尔，也要带基础护甲；她是帮你降低风险，不是替你承担所有风险。",[25,100,101],{"id":101},"四阶段建议",[103,104,105],"h3",{"id":105},"开局",[17,107,108],{},"利用群怪能力获取蛛网和基础战利品，但不要追进沼泽或大型敌群。",[103,110,111],{"id":111},"建家",[17,113,114],{},"帮助团队处理资源生物，并把怪物肉转化为可靠料理或其他资源。",[103,116,117],{"id":117},"中期",[17,119,120],{},"洞穴里阿比盖尔能协助清理小怪，但照明、理智与返程补给仍要独立准备。",[103,122,123],{"id":123},"后期",[17,125,126],{},"大型 Boss 战中把注意力放在走位、团队节奏和召回时机；不要只盯着阿比盖尔的伤害。",[25,128,129],{"id":129},"玩法方案",[131,132,133,140],"ul",{},[134,135,136,139],"li",{},[20,137,138],{},"新手稳定流："," 优先群怪资源，避免单挑高爆发敌人。",[134,141,142,145],{},[20,143,144],{},"多人辅助流："," 负责清杂、资源战斗和补给整理，为正面输出角色创造空间。",[25,147,149],{"id":148},"boss-表现","Boss 表现",[17,151,152,157],{},[153,154,156],"a",{"href":155},"\u002Fbosses\u002Fbee-queen","蜂后","会产生大量小怪，温蒂有明确价值，但战斗仍然高压。提前准备护甲、恢复和可靠移动空间。",[25,159,160],{"id":160},"常见误区",[131,162,163,166,169],{},[134,164,165],{},"阿比盖尔低状态时仍让她连续接战；",[134,167,168],{},"看到范围伤害强就直接挑战大型 Boss；",[134,170,171],{},"只采怪物肉，却没有安排烹饪与储存。",[25,173,174],{"id":174},"相关条目",[17,176,177,181,182,181,186],{},[153,178,180],{"href":179},"\u002Fwiki\u002Ffootball-helmet","橄榄球头盔"," · ",[153,183,185],{"href":184},"\u002Fwiki\u002Fpierogi","波兰水饺",[153,187,189],{"href":188},"\u002Fprogression\u002Fcaves-ruins","洞穴与遗迹线",{"title":191,"searchDepth":192,"depth":192,"links":193},"",2,[194,195,196,197,204,205,206,207],{"id":27,"depth":192,"text":27},{"id":89,"depth":192,"text":89},{"id":95,"depth":192,"text":95},{"id":101,"depth":192,"text":101,"children":198},[199,201,202,203],{"id":105,"depth":200,"text":105},3,{"id":111,"depth":200,"text":111},{"id":117,"depth":200,"text":117},{"id":123,"depth":200,"text":123},{"id":129,"depth":192,"text":129},{"id":148,"depth":192,"text":149},{"id":160,"depth":192,"text":160},{"id":174,"depth":192,"text":174},null,"阿比盖尔能高效处理群怪，是容错很高的新手角色。",1,"Wendy","md",{},true,"\u002Fcharacters\u002Fwendy",[217,218,219,220,221],"first-week","bee-queen","caves-ruins","football-helmet","pierogi",{"title":5,"description":209},"新手入门","characters\u002Fwendy",[226,227,228,229],"新手友好","辅助","群体战斗","多人","2026-07-31","2026.07","6nVSfFBgmo4iQNrG0etHptvkdmH7w48wJNNlnDN92-A",1785495330672]