[{"data":1,"prerenderedAt":238},["ShallowReactive",2],{"character-wigfrid":3},{"id":4,"title":5,"aliases":6,"body":9,"category":214,"description":215,"difficulty":198,"english":216,"extension":217,"meta":218,"navigation":219,"path":220,"related":221,"seo":227,"stage":228,"stem":229,"tags":230,"updatedAt":235,"version":236,"__hash__":237},"characters\u002Fcharacters\u002Fwigfrid.md","薇格弗德",[7,5,8],"wigfrid","女武神",{"type":10,"value":11,"toc":196},"minimark",[12,23,27,87,90,93,96,99,102,106,109,112,115,118,121,124,127,130,146,150,164,167,178,181],[13,14,15],"blockquote",{},[16,17,18,22],"p",{},[19,20,21],"strong",{},"一句话评价："," 薇格弗德很适合学习战斗节奏，但肉食限制要求你先理解哪些料理真的算肉食。",[24,25,26],"h2",{"id":26},"角色速览",[28,29,30,43],"table",{},[31,32,33],"thead",{},[34,35,36,40],"tr",{},[37,38,39],"th",{},"项目",[37,41,42],{},"结论",[44,45,46,55,63,71,79],"tbody",{},[34,47,48,52],{},[49,50,51],"td",{},"定位",[49,53,54],{},"战斗、团队装备",[34,56,57,60],{},[49,58,59],{},"上手难度",[49,61,62],{},"中低",[34,64,65,68],{},[49,66,67],{},"新手推荐",[49,69,70],{},"高",[34,72,73,76],{},[49,74,75],{},"适合模式",[49,77,78],{},"多人更突出",[34,80,81,84],{},[49,82,83],{},"主要限制",[49,85,86],{},"饮食选择受限",[24,88,89],{"id":89},"核心机制",[16,91,92],{},"战斗恢复提高了连续作战容错，专属装备也能帮助队友。但恢复不是无限的；面对高伤害或连续控制，仍要遵守攻击节奏并及时撤退。",[24,94,95],{"id":95},"开局路线",[16,97,98],{},"尽早建立可靠的肉食来源与烹饪锅。怪物肉可以进入料理，但不要直接大量食用。多人局中，提前和队友说明食物需求，避免所有肉类被拿去做不适合你的料理。",[24,100,101],{"id":101},"四阶段建议",[103,104,105],"h3",{"id":105},"开局",[16,107,108],{},"利用战斗优势处理蜘蛛等基础资源，同时佩戴护甲。",[103,110,111],{"id":111},"建家",[16,113,114],{},"稳定肉食与填充物循环，为团队准备通用头部护甲。",[103,116,117],{"id":117},"中期",[16,119,120],{},"承担季节 Boss、猎犬和洞穴战斗，但不要把战斗全部拉到基地核心。",[103,122,123],{"id":123},"后期",[16,125,126],{},"用团队装备和战斗能力支撑多人分工；机制型 Boss 仍要先完成场地与阶段要求。",[24,128,129],{"id":129},"玩法方案",[131,132,133,140],"ul",{},[134,135,136,139],"li",{},[19,137,138],{},"新手战斗流："," 可靠肉食 + 护甲轮换 + 少贪刀。",[134,141,142,145],{},[19,143,144],{},"团队装备流："," 批量准备头盔，让采集和辅助角色也能有稳定防护。",[24,147,149],{"id":148},"boss-表现","Boss 表现",[16,151,152,153,158,159,163],{},"面对",[154,155,157],"a",{"href":156},"\u002Fbosses\u002Fdeerclops","独眼巨鹿","和",[154,160,162],{"href":161},"\u002Fbosses\u002Fklaus","克劳斯","时稳定，但克劳斯的阶段机制不能靠恢复硬抗。",[24,165,166],{"id":166},"常见误区",[131,168,169,172,175],{},[134,170,171],{},"看到“战斗恢复”就不带治疗；",[134,173,174],{},"肉食储备不足，远行后被迫挨饿；",[134,176,177],{},"只给自己做装备，忽视角色的团队价值。",[24,179,180],{"id":180},"相关条目",[16,182,183,187,188,187,192],{},[154,184,186],{"href":185},"\u002Fwiki\u002Fmeatballs","肉丸"," · ",[154,189,191],{"href":190},"\u002Fwiki\u002Fhambat","火腿棒",[154,193,195],{"href":194},"\u002Fwiki\u002Ffootball-helmet","橄榄球头盔",{"title":197,"searchDepth":198,"depth":198,"links":199},"",2,[200,201,202,203,210,211,212,213],{"id":26,"depth":198,"text":26},{"id":89,"depth":198,"text":89},{"id":95,"depth":198,"text":95},{"id":101,"depth":198,"text":101,"children":204},[205,207,208,209],{"id":105,"depth":206,"text":105},3,{"id":111,"depth":206,"text":111},{"id":117,"depth":206,"text":117},{"id":123,"depth":206,"text":123},{"id":129,"depth":198,"text":129},{"id":148,"depth":198,"text":149},{"id":166,"depth":198,"text":166},{"id":180,"depth":198,"text":180},null,"战斗恢复和团队头盔让她很稳，但需要围绕肉食安排补给。","Wigfrid","md",{},true,"\u002Fcharacters\u002Fwigfrid",[222,223,224,225,226],"deerclops","klaus","football-helmet","hambat","meatballs",{"title":5,"description":215},"战斗入门","characters\u002Fwigfrid",[231,232,233,234],"战斗","团队","多人","Boss","2026-07-31","2026.07","35i96doYUN76reXAFT_c31SlE742SQYj0NEV7CFthOA",1785495330689]