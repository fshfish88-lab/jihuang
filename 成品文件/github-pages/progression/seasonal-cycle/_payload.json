[{"data":1,"prerenderedAt":202},["ShallowReactive",2],{"progression-seasonal-cycle":3},{"id":4,"title":5,"aliases":6,"body":10,"category":180,"description":181,"difficulty":180,"english":180,"extension":182,"meta":183,"navigation":184,"path":185,"related":186,"seo":192,"stage":193,"stem":194,"tags":195,"updatedAt":199,"version":200,"__hash__":201},"progression\u002Fprogression\u002Fseasonal-cycle.md","四季循环进阶路线",[7,8,9],"四季路线","春夏秋冬","季节循环",{"type":11,"value":12,"toc":168},"minimark",[13,24,28,37,40,76,79,97,100,113,116,130,133,136,139,162,165],[14,15,16],"blockquote",{},[17,18,19,23],"p",{},[20,21,22],"strong",{},"路线结论："," 四季生存不是临到换季再做装备，而是在上一个季节完成下一季的材料闭环，并把季节 Boss 的战场永远放在基地外。",[25,26,27],"h2",{"id":27},"开始阶段与前置",[17,29,30,31,36],{},"炼金引擎、烹饪锅、冰箱和稳定燃料已经就绪。最低物资线是",[32,33,35],"a",{"href":34},"\u002Fwiki\u002Fthermal-stone","温度石","、两套基础护甲、两把可靠武器与可即时恢复的料理。",[25,38,39],{"id":39},"最小准备",[41,42,43,52,60,73],"ul",{},[44,45,46,47,51],"li",{},"冬季：",[32,48,50],{"href":49},"\u002Fwiki\u002Fwinter-hat","冬帽","或更高保暖、热温度石、备用火把；",[44,53,54,55,59],{},"春季：",[32,56,58],{"href":57},"\u002Fwiki\u002Frain-coat","雨衣","或头身组合达到完整防雨；",[44,61,62,63,67,68,72],{},"夏季：",[32,64,66],{"href":65},"\u002Fwiki\u002Feyebrella","眼球伞","、冷温度石和基地",[32,69,71],{"href":70},"\u002Fwiki\u002Fendothermic-fire-pit","吸热火坑","；",[44,74,75],{},"全年：季节 Boss 战场、复活点和应急箱互不重叠。",[25,77,78],{"id":78},"节点路线",[17,80,81,82,86,87,91,92,96],{},"秋季先探索与建家，入冬前完成保暖和巨鹿空地。冬季储冰、击败",[32,83,85],{"href":84},"\u002Fwiki\u002Fdeerclops","独眼巨鹿","并把眼球留给眼球伞。春季先做防雨与避雷，再按需要处理",[32,88,90],{"href":89},"\u002Fwiki\u002Fmoose-goose","麋鹿鹅","。夏季进入地下或以冷源短途行动，向",[32,93,95],{"href":94},"\u002Fwiki\u002Fantlion","蚁狮","进贡，避免地陷破坏基地。",[25,98,99],{"id":99},"战斗与环境处理",[17,101,102,103,107,108,112],{},"听到季节巨兽警告就离家，不在箱子、锅和农田旁“临时打一会儿”。",[32,104,106],{"href":105},"\u002Fwiki\u002Fbearger","熊獾","可用于伐木，",[32,109,111],{"href":110},"\u002Fwiki\u002Fdragonfly","龙蝇","是固定区域 Boss，不属于必须在第一个年度完成的目标。",[25,114,115],{"id":115},"撤退信号",[41,117,118,121,124,127],{},[44,119,120],{},"护甲只剩最后一件；",[44,122,123],{},"温度石已回到中性且没有下一处冷\u002F热源；",[44,125,126],{},"潮湿、低理智与战斗压力同时出现两项；",[44,128,129],{},"Boss 行进方向重新指向基地。",[25,131,132],{"id":132},"收益与完成标志",[17,134,135],{},"基地具备可重复保暖、防雨、降温和灭火手段；四季 Boss 都有远离建筑的预案；换季前不再临时搜集核心材料。",[25,137,138],{"id":138},"相关百科",[17,140,141,145,146,145,150,145,154,145,158],{},[32,142,144],{"href":143},"\u002Fwiki\u002Fpuffy-vest","厚实背心"," · ",[32,147,149],{"href":148},"\u002Fwiki\u002Fchilled-amulet","寒冰护符",[32,151,153],{"href":152},"\u002Fwiki\u002Fluxury-fan","羽毛扇",[32,155,157],{"href":156},"\u002Fwiki\u002Fthermal-measurer","温度测量仪",[32,159,161],{"href":160},"\u002Fwiki\u002Fdesert-goggles","沙漠护目镜",[25,163,164],{"id":164},"来源",[17,166,167],{},"条目数值与机制链接至各百科页所列 Don't Starve Wiki；版本按《饥荒联机版》2026.08 数据核对。",{"title":169,"searchDepth":170,"depth":170,"links":171},"",2,[172,173,174,175,176,177,178,179],{"id":27,"depth":170,"text":27},{"id":39,"depth":170,"text":39},{"id":78,"depth":170,"text":78},{"id":99,"depth":170,"text":99},{"id":115,"depth":170,"text":115},{"id":132,"depth":170,"text":132},{"id":138,"depth":170,"text":138},{"id":164,"depth":170,"text":164},null,"把保暖、防雨、降温和四季巨兽预案串成可重复的年度循环。","md",{},true,"\u002Fprogression\u002Fseasonal-cycle",[187,188,189,190,191],"winter-hat","rain-coat","eyebrella","luxury-fan","antlion",{"title":5,"description":181},"第一个完整年度","progression\u002Fseasonal-cycle",[196,197,198],"主线","四季","季节 Boss","2026-08-08","2026.08","7pm12uXA_NVmnWNx_RlTRUwZFBymwJ0A0JxkYnAlPLA",1786565158285]