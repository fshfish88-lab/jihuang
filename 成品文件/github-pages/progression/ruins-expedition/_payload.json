[{"data":1,"prerenderedAt":202},["ShallowReactive",2],{"progression-ruins-expedition":3},{"id":4,"title":5,"aliases":6,"body":10,"category":180,"description":181,"difficulty":180,"english":180,"extension":182,"meta":183,"navigation":184,"path":185,"related":186,"seo":192,"stage":193,"stem":194,"tags":195,"updatedAt":199,"version":200,"__hash__":201},"progression\u002Fprogression\u002Fruins-expedition.md","遗迹远征进阶路线",[7,8,9],"遗迹远征","下洞路线","远古科技",{"type":11,"value":12,"toc":168},"minimark",[13,24,28,42,45,66,69,87,90,108,111,125,128,140,143,162,165],[14,15,16],"blockquote",{},[17,18,19,23],"p",{},[20,21,22],"strong",{},"路线结论："," 第一次遗迹远征的目标是建立可重复路线并带回第一批远古装备，不是把整片遗迹一次清空。",[25,26,27],"h2",{"id":27},"开始阶段与前置",[17,29,30,31,36,37,41],{},"地表基地已能独立运行，准备",[32,33,35],"a",{"href":34},"\u002Fwiki\u002Flantern","提灯","或",[32,38,40],{"href":39},"\u002Fwiki\u002Fmoggles","鼹鼠帽","、备用燃料、理智恢复、三套护甲、两把武器和一组返程食物。",[25,43,44],{"id":44},"最小准备",[46,47,48,57,60,63],"ul",{},[49,50,51,52,56],"li",{},"在",[32,53,55],{"href":54},"\u002Fwiki\u002Fcave-entrance","洞穴入口","两侧各放一份照明和食物；",[49,58,59],{},"带锤、镐、铲，但不要让工具挤掉战斗物资；",[49,61,62],{},"背包预留至少 6 格给铥矿、宝石和远古战利品；",[49,64,65],{},"记录入口、科技区和迷宫三个地图标记。",[25,67,68],{"id":68},"节点路线",[17,70,71,72,76,77,81,82,86],{},"入口补给点 → 蘑菇与兔人生态 → 泥泞区 → ",[32,73,75],{"href":74},"\u002Fwiki\u002Fruins","远古遗迹"," → 科技区 → 修复",[32,78,80],{"href":79},"\u002Fwiki\u002Fancient-pseudoscience-station","远古伪科学站"," → 制作一套远古护甲 → 迷宫 → ",[32,83,85],{"href":84},"\u002Fwiki\u002Fancient-guardian","远古守护者","。",[25,88,89],{"id":89},"战斗与环境处理",[17,91,92,93,97,98,102,103,107],{},"携带肉类会让",[32,94,96],{"href":95},"\u002Fwiki\u002Fbunnyman","兔人","敌对；梦魇阶段不要穿过",[32,99,101],{"href":100},"\u002Fwiki\u002Fsplumonkey","穴居猴","密集区。洞穴袭击的",[32,104,106],{"href":105},"\u002Fwiki\u002Fdepth-worm","洞穴蠕虫","应引到照明充足的开阔地统一处理。",[25,109,110],{"id":110},"撤退信号",[46,112,113,116,119,122],{},[49,114,115],{},"主照明低于 25%，且没有可补充灯泡；",[49,117,118],{},"梦魇阶段开启，同时有两组发条或影怪仇恨；",[49,120,121],{},"背包已装满高价值材料；",[49,123,124],{},"失去回到入口的明确地图路线。",[25,126,127],{"id":127},"收益与完成标志",[17,129,130,131,36,135,139],{},"拥有可重复的入口补给点、至少一个完整远古科技站位置、",[32,132,134],{"href":133},"\u002Fwiki\u002Fthulecite-crown","铥矿皇冠",[32,136,138],{"href":137},"\u002Fwiki\u002Fthulecite-suit","铥矿甲","，并安全带回守护者之角。",[25,141,142],{"id":142},"相关百科",[17,144,145,149,150,149,154,149,158],{},[32,146,148],{"href":147},"\u002Fwiki\u002Fmushroom-planter","蘑菇农场"," · ",[32,151,153],{"href":152},"\u002Fwiki\u002Fstar-callers-staff","唤星者魔杖",[32,155,157],{"href":156},"\u002Fwiki\u002Fdeconstruction-staff","解构魔杖",[32,159,161],{"href":160},"\u002Fwiki\u002Fslurper","啜食者",[25,163,164],{"id":164},"来源",[17,166,167],{},"机制与配方以各百科页列出的 Don't Starve Wiki（DST）为准。",{"title":169,"searchDepth":170,"depth":170,"links":171},"",2,[172,173,174,175,176,177,178,179],{"id":27,"depth":170,"text":27},{"id":44,"depth":170,"text":44},{"id":68,"depth":170,"text":68},{"id":89,"depth":170,"text":89},{"id":110,"depth":170,"text":110},{"id":127,"depth":170,"text":127},{"id":142,"depth":170,"text":142},{"id":164,"depth":170,"text":164},null,"从洞穴补给点到完整远古科技与守护者战利品的可撤退远征。","md",{},true,"\u002Fprogression\u002Fruins-expedition",[187,188,189,190,191],"cave-entrance","moggles","ruins","ancient-pseudoscience-station","ancient-guardian",{"title":5,"description":181},"稳定基地后","progression\u002Fruins-expedition",[196,197,198],"主线","洞穴","遗迹","2026-08-08","2026.08","9ZWowqvGR799ckdpt_t3f0qCC-FHlmO0oFQHYuCZAcY",1786559720846]