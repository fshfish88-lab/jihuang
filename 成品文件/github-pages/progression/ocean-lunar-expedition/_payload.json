[{"data":1,"prerenderedAt":203},["ShallowReactive",2],{"progression-ocean-lunar-expedition":3},{"id":4,"title":5,"aliases":6,"body":10,"category":182,"description":183,"difficulty":182,"english":182,"extension":184,"meta":185,"navigation":186,"path":187,"related":188,"seo":194,"stage":195,"stem":196,"tags":197,"updatedAt":200,"version":201,"__hash__":202},"progression\u002Fprogression\u002Focean-lunar-expedition.md","航海与月岛远征",[7,8,9],"月岛远征","航海路线","找月岛",{"type":11,"value":12,"toc":170},"minimark",[13,24,28,37,40,78,81,98,102,115,118,132,135,138,141,164,167],[14,15,16],"blockquote",{},[17,18,19,23],"p",{},[20,21,22],"strong",{},"路线结论："," 安全航海靠的是冗余：桅杆提供速度，船桨保证失去风帆后仍能返航，船补丁解决任何时候都可能出现的漏水。",[25,26,27],"h2",{"id":27},"开始阶段与前置",[17,29,30,31,36],{},"完成炼金科技，准备",[32,33,35],"a",{"href":34},"\u002Fwiki\u002Fboat-kit","船套装","与智囊团。第一艘远征船不要堆满建筑，先保证驾驶动线和修船位置畅通。",[25,38,39],{"id":39},"下水前清单",[41,42,43,60,72,75],"ul",{},[44,45,46,50,51,50,55,59],"li",{},[32,47,49],{"href":48},"\u002Fwiki\u002Fmast","桅杆","、",[32,52,54],{"href":53},"\u002Fwiki\u002Fsteering-wheel","舵轮",[32,56,58],{"href":57},"\u002Fwiki\u002Fanchor","锚","；",[44,61,62,66,67,71],{},[32,63,65],{"href":64},"\u002Fwiki\u002Foar","船桨"," ×2、",[32,68,70],{"href":69},"\u002Fwiki\u002Fboat-patch","船补丁","至少 6 个；",[44,73,74],{},"两天以上食物、移动照明、武器和防水；",[44,76,77],{},"基地海岸与出发方向地图标记。",[25,79,80],{"id":80},"节点路线",[17,82,83,84,88,89,50,93,97],{},"沿海试航 → 校准转向与制动 → 勘测大陆轮廓缺口 → 外海直线搜索 → 登陆",[32,85,87],{"href":86},"\u002Fwiki\u002Flunar-island","月岛"," → 标记祭坛部件 → 收集",[32,90,92],{"href":91},"\u002Fwiki\u002Fstone-fruit","石果",[32,94,96],{"href":95},"\u002Fwiki\u002Fkelp-stalk","海带茎","和月岩 → 返航移植。",[25,99,101],{"id":100},"修船照明与锚泊","修船、照明与锚泊",[17,103,104,105,109,110,114],{},"碰撞或",[32,106,108],{"href":107},"\u002Fwiki\u002Fcookie-cutter","饼干切割机","造成漏点后，先降帆和抛锚，再修补。夜间不要一边高速航行一边更换手持光源；固定",[32,111,113],{"href":112},"\u002Fwiki\u002Fboat-lantern","船灯","只负责甲板照明，仍需个人应急光源。",[25,116,117],{"id":117},"撤退信号",[41,119,120,123,126,129],{},[44,121,122],{},"船补丁少于 2 个；",[44,124,125],{},"船体多处漏水或低于安全耐久；",[44,127,128],{},"食物只够单程、地图上没有连续已知海岸；",[44,130,131],{},"风向持续把船推向礁石且备用船桨已损坏。",[25,133,134],{"id":134},"收益与完成标志",[17,136,137],{},"月岛海岸已标记，三组天体祭坛位置已确认；基地附近成功移植海带与石果；返航路线能够在一昼夜内重复。",[25,139,140],{"id":140},"相关百科",[17,142,143,147,148,147,152,147,156,147,160],{},[32,144,146],{"href":145},"\u002Fwiki\u002Fsalt-crystals","盐晶"," · ",[32,149,151],{"href":150},"\u002Fwiki\u002Fsalt-box","盐盒",[32,153,155],{"href":154},"\u002Fwiki\u002Fmoon-moth","月蛾",[32,157,159],{"href":158},"\u002Fwiki\u002Fglass-cutter","玻璃刀",[32,161,163],{"href":162},"\u002Fwiki\u002Fmoon-dial","月晷",[25,165,166],{"id":166},"来源",[17,168,169],{},"航海建筑、资源与月岛机制以各百科页列出的 Don't Starve Wiki（DST）为准。",{"title":171,"searchDepth":172,"depth":172,"links":173},"",2,[174,175,176,177,178,179,180,181],{"id":27,"depth":172,"text":27},{"id":39,"depth":172,"text":39},{"id":80,"depth":172,"text":80},{"id":100,"depth":172,"text":101},{"id":117,"depth":172,"text":117},{"id":134,"depth":172,"text":134},{"id":140,"depth":172,"text":140},{"id":166,"depth":172,"text":166},null,"从船体配置、海上应急到月岛定位、资源搬运和安全返航。","md",{},true,"\u002Fprogression\u002Focean-lunar-expedition",[189,190,191,192,193],"boat-patch","mast","steering-wheel","anchor","lunar-island",{"title":5,"description":183},"航海中期","progression\u002Focean-lunar-expedition",[198,199,87],"主线","航海","2026-08-08","2026.08","2wP96vWwSyzc7_hM7UARfGruSqyscHyS3D9TylX_MEE",1788923768067]