[{"data":1,"prerenderedAt":152},["ShallowReactive",2],{"progression-lunar-island":3},{"id":4,"title":5,"aliases":6,"body":10,"category":131,"description":132,"difficulty":131,"english":131,"extension":133,"meta":134,"navigation":135,"path":136,"related":137,"seo":143,"stage":144,"stem":145,"tags":146,"updatedAt":149,"version":150,"__hash__":151},"progression\u002Fprogression\u002Flunar-island.md","月岛与天体线",[7,8,9],"月岛","天体线","航海主线",{"type":11,"value":12,"toc":119},"minimark",[13,24,28,31,35,44,63,67,70,74,77,81,84,88,91,94,108,111],[14,15,16],"blockquote",{},[17,18,19,23],"p",{},[20,21,22],"strong",{},"路线结论："," 航海失败常常不是迷路，而是少带了锚、照明、修船材料或返航食物中的一项。",[25,26,27],"h2",{"id":27},"路线总览",[17,29,30],{},"准备航海科技 → 建造船只 → 配置船桨与锚 → 沿世界边缘探索 → 寻找月岛 → 建立登陆点 → 获取月亮资源 → 推进天体方向",[25,32,34],{"id":33},"节点一完成航海准备","节点一：完成航海准备",[17,36,37,38,43],{},"一块",[39,40,42],"a",{"href":41},"\u002Fwiki\u002Fboat-kit","船套装","只是平台。出发前还要准备：",[45,46,47,51,54,57,60],"ul",{},[48,49,50],"li",{},"船桨与可靠停船方式；",[48,52,53],{},"夜间照明；",[48,55,56],{},"修理和替换材料；",[48,58,59],{},"足够的食物、恢复与保暖\u002F降温方案；",[48,61,62],{},"返航方向与岸边标记。",[25,64,66],{"id":65},"节点二安全出航","节点二：安全出航",[17,68,69],{},"第一次航行先熟悉转向、停船和上下船，不要直接携带全部稀有物资。船上物品固定分区，避免紧急时找不到修理材料。",[25,71,73],{"id":72},"节点三寻找月岛","节点三：寻找月岛",[17,75,76],{},"结合海岸形状和世界边缘推测方向，按扇形或连续边界搜索，避免无计划在海上绕圈。食物消耗达到返程线时必须回头。",[25,78,80],{"id":79},"节点四建立登陆点","节点四：建立登陆点",[17,82,83],{},"登陆后标记船只位置，留下少量补给，并先理解月岛独特的理智表现和环境威胁。",[25,85,87],{"id":86},"节点五取得月亮资源","节点五：取得月亮资源",[17,89,90],{},"逐步收集月岛科技需要的材料。第一次回程以“安全带回关键样本”为目标，不要求把岛上所有内容一次完成。",[25,92,93],{"id":93},"路线完成标志",[45,95,96,99,102,105],{},[48,97,98],{},"有一套可重复使用的航海装备；",[48,100,101],{},"能稳定找到并往返月岛；",[48,103,104],{},"已理解当地环境与资源用途；",[48,106,107],{},"基地留有继续推进天体内容的材料。",[25,109,110],{"id":110},"下一步",[17,112,113,114,118],{},"继续推进月亮与天体后期内容，或切换到",[39,115,117],{"href":116},"\u002Fprogression\u002Fcaves-ruins","洞穴与遗迹线","，让两个方向的科技互相支撑。",{"title":120,"searchDepth":121,"depth":121,"links":122},"",2,[123,124,125,126,127,128,129,130],{"id":27,"depth":121,"text":27},{"id":33,"depth":121,"text":34},{"id":65,"depth":121,"text":66},{"id":72,"depth":121,"text":73},{"id":79,"depth":121,"text":80},{"id":86,"depth":121,"text":87},{"id":93,"depth":121,"text":93},{"id":110,"depth":121,"text":110},null,"从造船出海到月岛科技，为天体方向的后期内容打基础。","md",{},true,"\u002Fprogression\u002Flunar-island",[138,139,140,141,142],"boat-kit","wx-78","basic-survival","caves-ruins","first-week",{"title":5,"description":132},"航海与中后期","progression\u002Flunar-island",[147,148,7],"主线","航海","2026-07-31","2026.07","tpWru3hoMrTTvNQlUE8Ta0KpXtVVrOpsHLv36s9NxH8",1785495330790]