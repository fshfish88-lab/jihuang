[{"data":1,"prerenderedAt":202},["ShallowReactive",2],{"progression-boss-logistics":3},{"id":4,"title":5,"aliases":6,"body":10,"category":180,"description":181,"difficulty":180,"english":180,"extension":182,"meta":183,"navigation":184,"path":185,"related":186,"seo":192,"stage":193,"stem":194,"tags":195,"updatedAt":199,"version":200,"__hash__":201},"progression\u002Fprogression\u002Fboss-logistics.md","Boss 战备与后勤",[7,8,9],"Boss战备","打Boss准备","战斗后勤",{"type":11,"value":12,"toc":168},"minimark",[13,24,28,31,34,69,72,104,107,110,113,130,133,136,139,162,165],[14,15,16],"blockquote",{},[17,18,19,23],"p",{},[20,21,22],"strong",{},"路线结论："," Boss 战不是“带最好的装备”，而是把场地、补给、分工和撤退阈值写成一套能重复执行的清单。",[25,26,27],"h2",{"id":27},"前置与耗材估算",[17,29,30],{},"先查 Boss 百科中的生命、阶段和掉落。单人按预估战斗时长准备至少两倍护甲耐久；多人不简单按人数平分物资，要额外准备拉仇恨者的护甲和团队失误后的恢复冗余。",[25,32,33],{"id":33},"最小准备",[35,36,37,47,50,53,66],"ul",{},[38,39,40,41,46],"li",{},"武器：主武器两把或一把不会中途失效的",[42,43,45],"a",{"href":44},"\u002Fwiki\u002Fhambat","火腿棒","；",[38,48,49],{},"护甲：头身栏至少能覆盖两次连续失误；",[38,51,52],{},"恢复：即时治疗与主食分开，禁止战斗中才拆捆绑；",[38,54,55,56,60,61,65],{},"控场：",[42,57,59],{"href":58},"\u002Fwiki\u002Fpan-flute","排箫","、",[42,62,64],{"href":63},"\u002Fwiki\u002Ftooth-trap","犬牙陷阱","等按目标机制选择；",[38,67,68],{},"场地：无基地建筑、无中立生物、两条撤退方向。",[25,70,71],{"id":71},"节点路线",[17,73,74,75,79,80,84,85,89,90,94,95,89,99,103],{},"先练季节 Boss 的攻击节奏，再做",[42,76,78],{"href":77},"\u002Fwiki\u002Fbee-queen","蜂后","与",[42,81,83],{"href":82},"\u002Fwiki\u002Fklaus","克劳斯","等可控召唤战；航海后处理",[42,86,88],{"href":87},"\u002Fwiki\u002Fcrab-king","帝王蟹","和",[42,91,93],{"href":92},"\u002Fwiki\u002Fmalbatross","邪天翁","；拥有遗迹与位面装备后再挑战",[42,96,98],{"href":97},"\u002Fwiki\u002Ftoadstool","蟾蜍王",[42,100,102],{"href":101},"\u002Fwiki\u002Fancient-fuelweaver","远古织影者","。",[25,105,106],{"id":106},"场地与分工",[17,108,109],{},"拉仇恨者负责把攻击方向带离补给；输出者不穿过撤退线；清杂者优先处理会治疗、围堵或破坏船体的单位。所有人约定同一个撤退口令，撤退不是失败，而是保留下一次尝试的物资。",[25,111,112],{"id":112},"撤退阈值",[35,114,115,118,121,124,127],{},[38,116,117],{},"任何关键机制无人处理；",[38,119,120],{},"团队即时治疗剩余不足一轮；",[38,122,123],{},"主坦护甲只剩最后一套；",[38,125,126],{},"航海战船体出现两个以上未修漏点；",[38,128,129],{},"Boss 脱离预设场地并接近基地。",[25,131,132],{"id":132},"收益优先级",[17,134,135],{},"优先拿能改变长期效率的战利品：蜂王浆与捆绑包装、季节装备核心、遗迹\u002F位面主线物。装饰和重复蓝图放在后续稳定击杀。",[25,137,138],{"id":138},"相关百科",[17,140,141,145,146,145,150,145,154,145,158],{},[42,142,144],{"href":143},"\u002Fwiki\u002Ftentacle-spike","触手尖刺"," · ",[42,147,149],{"href":148},"\u002Fwiki\u002Fnight-armour","暗夜甲",[42,151,153],{"href":152},"\u002Fwiki\u002Fmarble-suit","大理石甲",[42,155,157],{"href":156},"\u002Fwiki\u002Fbee-mine","蜜蜂地雷",[42,159,161],{"href":160},"\u002Fwiki\u002Fweather-pain","天气风向标",[25,163,164],{"id":164},"来源",[17,166,167],{},"各 Boss 的出现条件、阶段和掉落以其结构化百科页来源为准。",{"title":169,"searchDepth":170,"depth":170,"links":171},"",2,[172,173,174,175,176,177,178,179],{"id":27,"depth":170,"text":27},{"id":33,"depth":170,"text":33},{"id":71,"depth":170,"text":71},{"id":106,"depth":170,"text":106},{"id":112,"depth":170,"text":112},{"id":132,"depth":170,"text":132},{"id":138,"depth":170,"text":138},{"id":164,"depth":170,"text":164},null,"用场地、护甲、武器、恢复和撤退阈值建立可复用的 Boss 战备体系。","md",{},true,"\u002Fprogression\u002Fboss-logistics",[187,188,189,190,191],"football-helmet","hambat","pan-flute","tooth-trap","weather-pain",{"title":5,"description":181},"中后期战斗","progression\u002Fboss-logistics",[196,197,198],"主线","Boss","后勤","2026-08-08","2026.08","qTisKMw6771luL6GPmoyLSNjgtDO8rznhOdEuSPX18w",1786559720864]