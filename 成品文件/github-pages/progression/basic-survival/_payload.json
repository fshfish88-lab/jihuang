[{"data":1,"prerenderedAt":198},["ShallowReactive",2],{"progression-basic-survival":3},{"id":4,"title":5,"aliases":6,"body":10,"category":176,"description":177,"difficulty":176,"english":176,"extension":178,"meta":179,"navigation":180,"path":181,"related":182,"seo":188,"stage":189,"stem":190,"tags":191,"updatedAt":195,"version":196,"__hash__":197},"progression\u002Fprogression\u002Fbasic-survival.md","基础生存线",[7,8,9],"基础生存","开荒路线","主线第一步",{"type":11,"value":12,"toc":162},"minimark",[13,24,28,31,35,57,61,64,68,80,84,92,96,109,113,120,124,132,135,146,149],[14,15,16],"blockquote",{},[17,18,19,23],"p",{},[20,21,22],"strong",{},"路线结论："," 基础生存线的终点不是“活过一天”，而是你不再依赖地图上的一次性采集，也知道每个季节来临前要准备什么。",[25,26,27],"h2",{"id":27},"路线总览",[17,29,30],{},"出生收集 → 地图探索 → 科学机器 → 选择基地 → 炼金引擎 → 食物循环 → 冬季准备 → 季节 Boss → 稳定四季",[25,32,34],{"id":33},"节点一收集基础材料","节点一：收集基础材料",[36,37,38,42,45,48],"ul",{},[39,40,41],"li",{},"推荐阶段：第 1 天；",[39,43,44],{},"必备：草、树枝、燧石、少量食物；",[39,46,47],{},"完成条件：可以制作基础工具与火把；",[39,49,50,51,56],{},"详情：",[52,53,55],"a",{"href":54},"\u002Fbeginner\u002Ffirst-day","第一天生存路线","。",[25,58,60],{"id":59},"节点二探索地图","节点二：探索地图",[17,62,63],{},"沿道路和海岸推进，寻找矿区、牛群、猪王、沼泽和关键特殊地形。探索的目标不是把地图全部涂满，而是知道高频资源在哪里。",[25,65,67],{"id":66},"节点三完成科技原型","节点三：完成科技原型",[17,69,70,71,75,76,56],{},"建造",[52,72,74],{"href":73},"\u002Fwiki\u002Fscience-machine","科学机器","，原型背包、长矛、木甲等物品。选择基地后再建造",[52,77,79],{"href":78},"\u002Fwiki\u002Falchemy-engine","炼金引擎",[25,81,83],{"id":82},"节点四建立基地","节点四：建立基地",[17,85,86,87,91],{},"参考",[52,88,90],{"href":89},"\u002Fbeginner\u002Fbase-location","建家选址","，让食物、燃料和重要路线保持合理距离。把烹饪、储物、种植和战斗缓冲区分开。",[25,93,95],{"id":94},"节点五形成食物循环","节点五：形成食物循环",[17,97,98,99,103,104,108],{},"用",[52,100,102],{"href":101},"\u002Fwiki\u002Fcrock-pot","烹饪锅","、",[52,105,107],{"href":106},"\u002Fwiki\u002Fice-box","冰箱","和可重复食材建立主食与恢复。完成标志是连续几天不再依赖随机浆果维生。",[25,110,112],{"id":111},"节点六准备第一个冬季","节点六：准备第一个冬季",[17,114,115,116,56],{},"保暖、燃料、食物和巨鹿预案同时完成。具体检查见",[52,117,119],{"href":118},"\u002Fbeginner\u002Ffirst-winter","第一个冬季准备",[25,121,123],{"id":122},"节点七处理季节-boss","节点七：处理季节 Boss",[17,125,126,127,131],{},"把 Boss 引离基地核心。第一次面对",[52,128,130],{"href":129},"\u002Fbosses\u002Fdeerclops","独眼巨鹿","时，保住基地比强行击杀更重要。",[25,133,134],{"id":134},"路线完成标志",[36,136,137,140,143],{},[39,138,139],{},"四季物资有提前准备节奏；",[39,141,142],{},"基地能稳定提供主食、恢复、护甲和照明；",[39,144,145],{},"出发去洞穴或海洋前，地表仍能独立运转。",[25,147,148],{"id":148},"下一路线",[17,150,151,152,156,157,161],{},"选择",[52,153,155],{"href":154},"\u002Fprogression\u002Fcaves-ruins","洞穴与遗迹线","获取远古科技，或选择",[52,158,160],{"href":159},"\u002Fprogression\u002Flunar-island","月岛与天体线","开始航海。",{"title":163,"searchDepth":164,"depth":164,"links":165},"",2,[166,167,168,169,170,171,172,173,174,175],{"id":27,"depth":164,"text":27},{"id":33,"depth":164,"text":34},{"id":59,"depth":164,"text":60},{"id":66,"depth":164,"text":67},{"id":82,"depth":164,"text":83},{"id":94,"depth":164,"text":95},{"id":111,"depth":164,"text":112},{"id":122,"depth":164,"text":123},{"id":134,"depth":164,"text":134},{"id":148,"depth":164,"text":148},null,"从出生、科技、基地到四季循环，建立可以长期运转的世界。","md",{},true,"\u002Fprogression\u002Fbasic-survival",[183,184,185,186,187],"first-day","first-week","base-location","first-winter","deerclops",{"title":5,"description":177},"开局至稳定基地","progression\u002Fbasic-survival",[192,193,194],"主线","新手","地表","2026-07-31","2026.07","f2tojUgKYq_SW8iY71Kwh76uwp-OH7_VfgyP-NrK7q4",1785483019345]