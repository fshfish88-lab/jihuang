[{"data":1,"prerenderedAt":164},["ShallowReactive",2],{"progression-caves-ruins":3},{"id":4,"title":5,"aliases":6,"body":10,"category":144,"description":145,"difficulty":144,"english":144,"extension":146,"meta":147,"navigation":148,"path":149,"related":150,"seo":156,"stage":157,"stem":158,"tags":159,"updatedAt":161,"version":162,"__hash__":163},"progression\u002Fprogression\u002Fcaves-ruins.md","洞穴与遗迹线",[7,8,9],"洞穴","遗迹","铥矿路线",{"type":11,"value":12,"toc":131},"minimark",[13,24,28,31,35,38,64,68,71,75,78,82,85,89,92,96,104,107,121,124],[14,15,16],"blockquote",{},[17,18,19,23],"p",{},[20,21,22],"strong",{},"路线结论："," 洞穴路线最重要的不是一次走多远，而是让照明、理智、补给和返程都能重复。",[25,26,27],"h2",{"id":27},"路线总览",[17,29,30],{},"准备洞穴装备 → 选择入口 → 建地下补给点 → 探索洞穴生态 → 定位遗迹 → 获取铥矿 → 修复远古科技 → 迷宫 → 远古守护者",[25,32,34],{"id":33},"节点一准备装备","节点一：准备装备",[17,36,37],{},"至少携带：",[39,40,41,55,58,61],"ul",{},[42,43,44,49,50,54],"li",{},[45,46,48],"a",{"href":47},"\u002Fwiki\u002Flantern","提灯","或",[45,51,53],{"href":52},"\u002Fwiki\u002Fminer-hat","矿工帽","与备用燃料；",[42,56,57],{},"武器、多套护甲和恢复料理；",[42,59,60],{},"理智恢复、主食和返程火源；",[42,62,63],{},"少量建材，用于入口补给点。",[25,65,67],{"id":66},"节点二选择入口","节点二：选择入口",[17,69,70],{},"优先从往返基地方便的入口开始。进入后先确认出口和地图方向，不要一落地就追逐远处资源。",[25,72,74],{"id":73},"节点三建立补给点","节点三：建立补给点",[17,76,77],{},"入口附近存放备用照明、食物和基础装备。死亡或紧急返程后，你应能在这里重新组织，而不是从地表基地完整重做。",[25,79,81],{"id":80},"节点四探索洞穴","节点四：探索洞穴",[17,83,84],{},"记录光照区域、危险生态与可长期利用的资源。理智过低或照明不足时，主动返回补给点，不把两个风险叠加。",[25,86,88],{"id":87},"节点五定位遗迹","节点五：定位遗迹",[17,90,91],{},"装备升级后再进入遗迹。遗迹阶段的目标是找到科技区与迷宫路线，而不是见到每个敌人都战斗。",[25,93,95],{"id":94},"节点六挑战远古守护者","节点六：挑战远古守护者",[17,97,98,99,103],{},"在开阔、明亮且已清场的位置处理冲撞。完整准备见",[45,100,102],{"href":101},"\u002Fbosses\u002Fancient-guardian","远古守护者攻略","。",[25,105,106],{"id":106},"路线完成标志",[39,108,109,112,115,118],{},[42,110,111],{},"地下入口有可重复使用的补给；",[42,113,114],{},"能稳定往返遗迹；",[42,116,117],{},"已取得关键远古资源并理解修复科技；",[42,119,120],{},"远古守护者战利品已安全带回。",[25,122,123],{"id":123},"下一步",[17,125,126,127,103],{},"继续探索遗迹与暗影方向，或回到地表准备",[45,128,130],{"href":129},"\u002Fprogression\u002Flunar-island","月岛与天体线",{"title":132,"searchDepth":133,"depth":133,"links":134},"",2,[135,136,137,138,139,140,141,142,143],{"id":27,"depth":133,"text":27},{"id":33,"depth":133,"text":34},{"id":66,"depth":133,"text":67},{"id":73,"depth":133,"text":74},{"id":80,"depth":133,"text":81},{"id":87,"depth":133,"text":88},{"id":94,"depth":133,"text":95},{"id":106,"depth":133,"text":106},{"id":123,"depth":133,"text":123},null,"建立地下补给点，寻找远古遗迹并取得铥矿科技。","md",{},true,"\u002Fprogression\u002Fcaves-ruins",[151,152,153,154,155],"lantern","miner-hat","ancient-guardian","wx-78","basic-survival",{"title":5,"description":145},"稳定基地后","progression\u002Fcaves-ruins",[160,7,8],"主线","2026-07-31","2026.07","4DXaLZ8HEaPMpU7j19MCHBTjpJGks_el_pJafOHtCK0",1785483019363]