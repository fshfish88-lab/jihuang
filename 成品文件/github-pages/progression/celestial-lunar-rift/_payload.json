[{"data":1,"prerenderedAt":196},["ShallowReactive",2],{"progression-celestial-lunar-rift":3},{"id":4,"title":5,"aliases":6,"body":10,"category":175,"description":176,"difficulty":175,"english":175,"extension":177,"meta":178,"navigation":179,"path":180,"related":181,"seo":187,"stage":188,"stem":189,"tags":190,"updatedAt":193,"version":194,"__hash__":195},"progression\u002Fprogression\u002Fcelestial-lunar-rift.md","天体与月亮裂隙路线",[7,8,9],"天体裂隙","亮茄路线","月亮阵营",{"type":11,"value":12,"toc":163},"minimark",[13,24,28,42,45,66,69,92,95,113,116,134,137,151,154,157,160],[14,15,16],"blockquote",{},[17,18,19,23],"p",{},[20,21,22],"strong",{},"路线结论："," 月亮裂隙是会改变世界生态的后期选择。先完成天体英雄并囤好位面战备，再开启裂隙，才能把亮茄入侵转化为稳定材料循环。",[25,26,27],"h2",{"id":27},"前置条件",[17,29,30,31,36,37,41],{},"完成月岛勘测并组装",[32,33,35],"a",{"href":34},"\u002Fwiki\u002Fcelestial-altar","天体祭坛","，升级",[32,38,40],{"href":39},"\u002Fwiki\u002Fcelestial-portal","天体传送门","，遗迹与航海补给线都能重复运行。",[25,43,44],{"id":44},"最小准备",[46,47,48,57,60,63],"ul",{},[49,50,51,52,56],"li",{},"天文护目镜与",[32,53,55],{"href":54},"\u002Fwiki\u002Fmoon-storm","月亮风暴","任务所需工具；",[49,58,59],{},"三阶段 Boss 的多套护甲、移速和启蒙控制；",[49,61,62],{},"基地作物区分散布局，防止亮茄入侵一次封锁全部食物线；",[49,64,65],{},"至少一套非位面备用装备，避免稀有材料耗尽后无法收尸。",[25,67,68],{"id":68},"节点路线",[17,70,71,72,76,77,81,82,86,87,91],{},"天体祭坛 → 天体传送门 → 月亮风暴 → 收集",[32,73,75],{"href":74},"\u002Fwiki\u002Frestrained-static","约束静电"," → 完成实验 → 挑战",[32,78,80],{"href":79},"\u002Fwiki\u002Fcelestial-champion","天体英雄"," → 制作",[32,83,85],{"href":84},"\u002Fwiki\u002Fenlightened-crown","启迪之冠"," → 确认开启",[32,88,90],{"href":89},"\u002Fwiki\u002Flunar-rift","月亮裂隙"," → 处理啃食者和致命亮茄 → 建立亮茄制作站。",[25,93,94],{"id":94},"裂隙资源循环",[17,96,97,98,102,103,107,108,112],{},"裂隙晶簇附近先处理",[32,99,101],{"href":100},"\u002Fwiki\u002Fgrazer","啃食者","，再开采纯粹辉煌。基地被",[32,104,106],{"href":105},"\u002Fwiki\u002Fdeadly-brightshade","致命亮茄","侵占时，清理根刺、击杀主体并收集",[32,109,111],{"href":110},"\u002Fwiki\u002Fbrightshade-husk","亮茄外壳","。两种材料一起投入亮茄装备，而不是只囤其中一种。",[25,114,115],{"id":115},"装备顺序",[17,117,118,119,123,124,128,129,133],{},"需要安全远程清怪先做",[32,120,122],{"href":121},"\u002Fwiki\u002Fbrightshade-staff","亮茄魔杖","；主打近战做",[32,125,127],{"href":126},"\u002Fwiki\u002Fbrightshade-sword","亮茄剑","；头甲优先配套；",[32,130,132],{"href":131},"\u002Fwiki\u002Fbrightshade-bomb","亮茄炸弹","留给啃食者、密集目标和明确的爆发窗口，绝不在基地内试投。",[25,135,136],{"id":136},"撤退信号",[46,138,139,142,145,148],{},[49,140,141],{},"位面护甲归零且没有修理包；",[49,143,144],{},"启蒙压力妨碍正常操作；",[49,146,147],{},"两组亮茄攻击范围重叠；",[49,149,150],{},"裂隙晶体旁啃食者数量超过当前爆发能力。",[25,152,153],{"id":153},"完成标志",[17,155,156],{},"能稳定取得纯粹辉煌与亮茄外壳，拥有至少一套亮茄武器\u002F护甲组合，并保留修理材料。",[25,158,159],{"id":159},"来源",[17,161,162],{},"月亮裂隙和亮茄装备机制以 Don't Starve Wiki 的 From Beyond \u002F Lunar Rift 条目核对。",{"title":164,"searchDepth":165,"depth":165,"links":166},"",2,[167,168,169,170,171,172,173,174],{"id":27,"depth":165,"text":27},{"id":44,"depth":165,"text":44},{"id":68,"depth":165,"text":68},{"id":94,"depth":165,"text":94},{"id":115,"depth":165,"text":115},{"id":136,"depth":165,"text":136},{"id":153,"depth":165,"text":153},{"id":159,"depth":165,"text":159},null,"完成天体英雄、开启月亮裂隙并建立亮茄材料与装备循环。","md",{},true,"\u002Fprogression\u002Fcelestial-lunar-rift",[182,183,184,185,186],"celestial-altar","moon-storm","celestial-champion","lunar-rift","brightshade-husk",{"title":5,"description":176},"天体后期","progression\u002Fcelestial-lunar-rift",[191,192,90],"主线","天体","2026-08-08","2026.08","Ok0hgEGIigjlM00OHkxQ0RrRsJVsRceC7pDfidn5514",1786544676884]