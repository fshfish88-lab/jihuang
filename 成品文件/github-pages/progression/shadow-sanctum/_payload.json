[{"data":1,"prerenderedAt":205},["ShallowReactive",2],{"progression-shadow-sanctum":3},{"id":4,"title":5,"aliases":6,"body":10,"category":183,"description":184,"difficulty":183,"english":183,"extension":185,"meta":186,"navigation":187,"path":188,"related":189,"seo":195,"stage":196,"stem":197,"tags":198,"updatedAt":202,"version":203,"__hash__":204},"progression\u002Fprogression\u002Fshadow-sanctum.md","暗影裂隙与远古圣所",[7,8,9],"暗影圣所","Sanctum","钥石路线",{"type":11,"value":12,"toc":170},"minimark",[13,24,28,52,55,71,74,97,100,103,106,109,112,126,130,158,161,164,167],[14,15,16],"blockquote",{},[17,18,19,23],"p",{},[20,21,22],"strong",{},"路线结论："," 圣所是不能靠传送跳过房间机制的多人同步路线。先把遗迹补给、织影者和暗影裂隙做成稳定前置，再以罗盘、脉冲、守卫塔和钥石为四个明确目标推进。",[25,26,27],"h2",{"id":27},"前置条件",[17,29,30,31,36,37,41,42,46,47,51],{},"完成",[32,33,35],"a",{"href":34},"\u002Fwiki\u002Fancient-guardian","远古守护者","与遗迹科技，击败",[32,38,40],{"href":39},"\u002Fwiki\u002Fancient-fuelweaver","远古织影者","，开启",[32,43,45],{"href":44},"\u002Fwiki\u002Fshadow-rift","暗影裂隙","并准备位面防御。",[32,48,50],{"href":49},"\u002Fwiki\u002Fdreadstone-helm","绝望石头盔","或虚空套装不是强制，但能显著提高容错。",[25,53,54],{"id":54},"最小准备",[56,57,58,62,65,68],"ul",{},[59,60,61],"li",{},"两套可修复位面护甲、主副武器、即时治疗；",[59,63,64],{},"长时间照明和理智恢复；",[59,66,67],{},"绳子，用于钥石房裂隙的快速撤离路径；",[59,69,70],{},"团队统一进入和路标切换，不留单人滞留旧房间。",[25,72,73],{"id":73},"节点路线",[17,75,76,77,81,82,86,87,91,92,96],{},"织影者 → 暗影裂隙资源 → 远古档案巨型漩涡 → ",[32,78,80],{"href":79},"\u002Fwiki\u002Fsanctum","远古圣所","大厅 → 搜索",[32,83,85],{"href":84},"\u002Fwiki\u002Fwaymark-compass","路标罗盘"," → 罗盘指引正确路标 → 收集并搬运安全脉冲 → 钥石房 → 激活四座",[32,88,90],{"href":89},"\u002Fwiki\u002Fancient-guard-tower","远古守卫塔"," → 取得",[32,93,95],{"href":94},"\u002Fwiki\u002Fkeystone","钥石"," → 绳索撤离。",[25,98,99],{"id":99},"导航与房间规则",[17,101,102],{},"所有圣所内玩家必须同时接触同一个路标才能切换房间。路标罗盘只在圣所生效；手持时不仅指向钥石房路线，还会吸引附近最多四个安全脉冲。不要把关键物资散落在即将切换的动线上。",[25,104,105],{"id":105},"守卫塔战",[17,107,108],{},"四座塔全部激活后开战。它们免疫冰冻、催眠和电击；集中处理一座，低于半血时利用 15 秒眩晕易伤窗口爆发。击退会打乱站位，补给不要放在房间边缘。",[25,110,111],{"id":111},"撤退信号",[56,113,114,117,120,123],{},[59,115,116],{},"队员无法同步进入同一路标；",[59,118,119],{},"两座以上守卫塔同时贴身且仇恨失控；",[59,121,122],{},"位面护甲或即时治疗不足一轮；",[59,124,125],{},"已取得钥石但返程绳索或出口路线不清楚。",[25,127,129],{"id":128},"_2026-热能支线","2026 热能支线",[17,131,132,133,137,138,142,143,147,148,152,153,157],{},"圣所地热区的",[32,134,136],{"href":135},"\u002Fwiki\u002Fgeothermite","地热螨","有 50% 概率掉落",[32,139,141],{"href":140},"\u002Fwiki\u002Fheat-gland","热腺体","。保持生鲜可制作",[32,144,146],{"href":145},"\u002Fwiki\u002Fardent-axe","炽热斧","、",[32,149,151],{"href":150},"\u002Fwiki\u002Fpyretic-pickaxe","炎热镐","和",[32,154,156],{"href":155},"\u002Fwiki\u002Fthermal-balm","热疗药膏","；烤熟热腺体不能继续制作。",[25,159,160],{"id":160},"完成标志",[17,162,163],{},"取得钥石并通过裂隙安全撤出；理解向远古大门交付钥石会触发确认并重置圣所，不在没有备份路线时误操作。",[25,165,166],{"id":166},"来源",[17,168,169],{},"2026 内容按 Klei《Cursed Confrontation Part 1》正式更新说明与 Don't Starve Wiki 的 Sanctum、Waymark Compass、Ancient Guard Tower、Keystone 条目核对。",{"title":171,"searchDepth":172,"depth":172,"links":173},"",2,[174,175,176,177,178,179,180,181,182],{"id":27,"depth":172,"text":27},{"id":54,"depth":172,"text":54},{"id":73,"depth":172,"text":73},{"id":99,"depth":172,"text":99},{"id":105,"depth":172,"text":105},{"id":111,"depth":172,"text":111},{"id":128,"depth":172,"text":129},{"id":160,"depth":172,"text":160},{"id":166,"depth":172,"text":166},null,"从织影者、暗影裂隙推进到圣所导航、守卫塔和钥石撤离。","md",{},true,"\u002Fprogression\u002Fshadow-sanctum",[190,191,192,193,194],"ancient-fuelweaver","shadow-rift","sanctum","waymark-compass","keystone",{"title":5,"description":184},"暗影终局与 2026 圣所","progression\u002Fshadow-sanctum",[199,200,201],"主线","暗影","圣所","2026-08-08","2026.08","P-BdjfjBiSpXkjo3lAcYmESDVGPb_SmtXi_7l34ZXR0",1786544676893]