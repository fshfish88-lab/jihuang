[{"data":1,"prerenderedAt":163},["ShallowReactive",2],{"boss-bearger":3},{"id":4,"title":5,"aliases":6,"body":10,"category":139,"description":140,"difficulty":134,"english":141,"extension":142,"meta":143,"navigation":144,"path":145,"related":146,"seo":152,"stage":153,"stem":154,"tags":155,"updatedAt":160,"version":161,"__hash__":162},"bosses\u002Fbosses\u002Fbearger.md","熊獾",[7,8,9,5],"熊大","秋季boss","bearger",{"type":11,"value":12,"toc":124},"minimark",[13,24,28,44,47,50,53,73,76,80,83,86,89,92,95,98,112,115],[14,15,16],"blockquote",{},[17,18,19,23],"p",{},[20,21,22],"strong",{},"一句话结论："," 熊獾最大的危险不是血量，而是它出现在错误的位置；先带走，再战斗或利用。",[25,26,27],"h2",{"id":27},"基本信息",[29,30,31,35,38,41],"ul",{},[32,33,34],"li",{},"出现阶段：秋季相关阶段；",[32,36,37],{},"主要风险：破坏建筑、范围攻击、战场混乱；",[32,39,40],{},"是否主线必要：不是；",[32,42,43],{},"额外价值：可以帮助砍树或清理密集资源。",[25,45,46],{"id":46},"战前准备",[17,48,49],{},"把战斗位置放在远离基地的空地。携带武器、多套护甲、恢复、照明和应急火源；附近如果有大量树木，要先决定是利用它工作还是保持场地干净。",[25,51,52],{"id":52},"三档配置",[29,54,55,61,67],{},[32,56,57,60],{},[20,58,59],{},"最低配置："," 护甲、武器、基础恢复，只负责引走。",[32,62,63,66],{},[20,64,65],{},"新手推荐："," 火腿棒、多顶头盔、稳定恢复和清晰绕圈空间。",[32,68,69,72],{},[20,70,71],{},"高效配置："," 战斗角色负责输出，其他玩家清理额外生物并准备替换装备。",[25,74,75],{"id":75},"战斗方法",[77,78,79],"h3",{"id":79},"常规走位",[17,81,82],{},"观察攻击动作，离开危险范围后回身输出。熊獾可能改变节奏，不要机械地固定贪刀次数。",[77,84,85],{"id":85},"资源利用",[17,87,88],{},"让它撞击树群可以节省砍伐时间，但会引发额外目标和地面物品堆积。利用结束后把它继续带离基地，再决定击杀。",[25,90,91],{"id":91},"失误处理",[17,93,94],{},"被命中后先确认护甲是否仍在，再拉开距离恢复。如果周围出现额外敌人，不要同时处理所有目标；把战线拉长，重新获得单一节奏。",[25,96,97],{"id":97},"常见失败原因",[29,99,100,103,106,109],{},[32,101,102],{},"发现熊獾后直接在储物区开打；",[32,104,105],{},"一边捡地面木材一边战斗；",[32,107,108],{},"夜间照明不足，攻击前摇看不清；",[32,110,111],{},"备用护甲放在基地而不是战场旁。",[25,113,114],{"id":114},"击败后",[17,116,117,118,123],{},"整理掉落和被破坏区域，并重新评估",[119,120,122],"a",{"href":121},"\u002Fbeginner\u002Fbase-location","建家选址","的安全缓冲。准备进入新的季节循环。",{"title":125,"searchDepth":126,"depth":126,"links":127},"",2,[128,129,130,131,136,137,138],{"id":27,"depth":126,"text":27},{"id":46,"depth":126,"text":46},{"id":52,"depth":126,"text":52},{"id":75,"depth":126,"text":75,"children":132},[133,135],{"id":79,"depth":134,"text":79},3,{"id":85,"depth":134,"text":85},{"id":91,"depth":126,"text":91},{"id":97,"depth":126,"text":97},{"id":114,"depth":126,"text":114},null,"秋季出现的拆家高手，也能被利用来砍树和清理资源区。","Bearger","md",{},true,"\u002Fbosses\u002Fbearger",[147,148,149,150,151],"base-location","wigfrid","hambat","football-helmet","basic-survival",{"title":5,"description":140},"第二个秋季起","bosses\u002Fbearger",[156,157,158,159],"地表","季节 Boss","可选","单人","2026-07-31","2026.07","CiPDdu-GyoIYF5lzyzIs-Nr_qxHWLIwmVtop2bIZl6M",1785495330727]