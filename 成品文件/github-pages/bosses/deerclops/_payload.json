[{"data":1,"prerenderedAt":190},["ShallowReactive",2],{"boss-deerclops":3},{"id":4,"title":5,"aliases":6,"body":11,"category":166,"description":167,"difficulty":159,"english":168,"extension":169,"meta":170,"navigation":171,"path":172,"related":173,"seo":179,"stage":180,"stem":181,"tags":182,"updatedAt":187,"version":188,"__hash__":189},"bosses\u002Fbosses\u002Fdeerclops.md","独眼巨鹿",[7,8,9,10],"巨鹿","冬季boss","deerclops","dl",{"type":12,"value":13,"toc":150},"minimark",[14,25,29,45,48,57,60,64,67,70,82,85,93,96,99,102,117,120,134,137],[15,16,17],"blockquote",{},[18,19,20,24],"p",{},[21,22,23],"strong",{},"一句话结论："," 听到警告后先离开基地；保住建筑，再处理巨鹿，优先级永远正确。",[26,27,28],"h2",{"id":28},"基本信息",[30,31,32,36,39,42],"ul",{},[33,34,35],"li",{},"出现阶段：冬季；",[33,37,38],{},"主要风险：范围攻击、理智压力、破坏建筑；",[33,40,41],{},"是否主线必要：不是，但掉落物很有价值；",[33,43,44],{},"场地原则：远离锅、冰箱、箱子和科技建筑。",[26,46,47],{"id":47},"挑战前置",[18,49,50,51,56],{},"完成",[52,53,55],"a",{"href":54},"\u002Fbeginner\u002Ffirst-winter","第一个冬季准备","，提前确定战斗区和撤退方向。多人局应说清楚由谁吸引、谁输出、谁携带备用装备。",[26,58,59],{"id":59},"三档配置",[61,62,63],"h3",{"id":63},"最低配置",[18,65,66],{},"可靠武器、两件护甲、少量恢复、火把和营火材料。适合只求把巨鹿引离基地，不强求立即击杀。",[61,68,69],{"id":69},"新手推荐",[18,71,72,76,77,81],{},[52,73,75],{"href":74},"\u002Fwiki\u002Fhambat","火腿棒","、多顶",[52,78,80],{"href":79},"\u002Fwiki\u002Ffootball-helmet","橄榄球头盔","、恢复料理、暖石与充足照明。",[61,83,84],{"id":84},"高效配置",[18,86,87,88,92],{},"在推荐配置基础上，由",[52,89,91],{"href":90},"\u002Fcharacters\u002Fwolfgang","沃尔夫冈","或其他战斗角色承担主要输出，团队负责维持温度和装备轮换。",[26,94,95],{"id":95},"战斗节奏",[18,97,98],{},"观察攻击前摇，躲开范围后短暂输出，再主动让出下一次攻击空间。新手先从少打一次开始，确认节奏后再增加攻击次数。失误挨打后先拉开距离、补甲和恢复，不要在低血线继续抢伤害。",[26,100,101],{"id":101},"两种稳妥打法",[103,104,105,111],"ol",{},[33,106,107,110],{},[21,108,109],{},"常规走位："," 在清理过的场地绕开攻击，利用攻击后摇输出。",[33,112,113,116],{},[21,114,115],{},"环境利用："," 把巨鹿引到远离基地的生物或资源区，让它帮忙清理；风险是战场更混乱，必须保留撤退路线。",[26,118,119],{"id":119},"常见失败原因",[30,121,122,125,128,131],{},[33,123,124],{},"在基地核心等待它出现；",[33,126,127],{},"护甲损坏后没有立即更换；",[33,129,130],{},"低理智引发额外暗影威胁；",[33,132,133],{},"只顾战斗，忘记冬季温度与照明。",[26,135,136],{"id":136},"掉落与下一步",[18,138,139,140,144,145,149],{},"击败后妥善保存关键掉落，用于重要的季节生存装备。接下来可以推进",[52,141,143],{"href":142},"\u002Fprogression\u002Fcaves-ruins","洞穴与遗迹线","或准备冬季的",[52,146,148],{"href":147},"\u002Fbosses\u002Fklaus","克劳斯","。",{"title":151,"searchDepth":152,"depth":152,"links":153},"",2,[154,155,156,162,163,164,165],{"id":28,"depth":152,"text":28},{"id":47,"depth":152,"text":47},{"id":59,"depth":152,"text":59,"children":157},[158,160,161],{"id":63,"depth":159,"text":63},3,{"id":69,"depth":159,"text":69},{"id":84,"depth":159,"text":84},{"id":95,"depth":152,"text":95},{"id":101,"depth":152,"text":101},{"id":119,"depth":152,"text":119},{"id":136,"depth":152,"text":136},null,"第一个冬季最常见的基地威胁；把它引离建筑，再决定打或拖。","Deerclops","md",{},true,"\u002Fbosses\u002Fdeerclops",[174,175,176,177,178],"first-winter","wilson","wolfgang","football-helmet","hambat",{"title":5,"description":167},"第一个冬季","bosses\u002Fdeerclops",[183,184,185,186],"地表","季节 Boss","可选","单人","2026-07-31","2026.07","MnxoT52VsQzhuCMq0hrWirvu1ZiecCheOogagr723GY",1785483019276]