[{"data":1,"prerenderedAt":176},["ShallowReactive",2],{"boss-ancient-guardian":3},{"id":4,"title":5,"aliases":6,"body":10,"category":151,"description":152,"difficulty":153,"english":154,"extension":155,"meta":156,"navigation":157,"path":158,"related":159,"seo":165,"stage":166,"stem":167,"tags":168,"updatedAt":173,"version":174,"__hash__":175},"bosses\u002Fbosses\u002Fancient-guardian.md","远古守护者",[5,7,8,9],"犀牛","ancient guardian","ag",{"type":11,"value":12,"toc":132},"minimark",[13,24,28,50,53,61,64,68,71,74,77,80,88,91,94,97,100,103,106,109,112,126,129],[14,15,16],"blockquote",{},[17,18,19,23],"p",{},[20,21,22],"strong",{},"一句话结论："," 远古守护者的战斗先解决“看得见、跑得开、不会引来更多怪”，然后才是输出。",[25,26,27],"h2",{"id":27},"基本信息",[29,30,31,35,38,47],"ul",{},[32,33,34],"li",{},"出现位置：遗迹迷宫相关区域；",[32,36,37],{},"主要风险：高速冲撞、狭窄地形、地下照明与额外生物；",[32,39,40,41,46],{},"所属路线：",[42,43,45],"a",{"href":44},"\u002Fprogression\u002Fcaves-ruins","洞穴与遗迹线","；",[32,48,49],{},"是否可重复准备：失败后可以重整，没必要带全部稀有物资一次压上。",[25,51,52],{"id":52},"挑战前置",[17,54,55,56,60],{},"确认返程路线和地下补给点。准备可放置的",[42,57,59],{"href":58},"\u002Fwiki\u002Flantern","提灯","或稳定头部照明、武器、多套护甲、恢复与理智管理物资。",[25,62,63],{"id":63},"三档配置",[65,66,67],"h3",{"id":67},"最低配置",[17,69,70],{},"稳定照明、两套护甲、常规武器和基础恢复。只适合熟悉路线的玩家。",[65,72,73],{"id":73},"新手推荐",[17,75,76],{},"多盏可放置照明、火腿棒、多顶头盔、恢复料理，并提前清理迷宫附近的额外敌人。",[65,78,79],{"id":79},"高效配置",[17,81,82,83,87],{},"由",[42,84,86],{"href":85},"\u002Fcharacters\u002Fwolfgang","沃尔夫冈","等战斗角色利用明确输出窗口，其他玩家负责照明、清场和补给。",[25,89,90],{"id":90},"战斗方法",[65,92,93],{"id":93},"开阔场地走位",[17,95,96],{},"把战斗引到有足够长度的通道或空间，观察冲撞方向并提前离开路径。冲撞结束后再靠近输出。",[65,98,99],{"id":99},"地形控制",[17,101,102],{},"熟悉地形后可利用可靠障碍限制冲撞，但不要依赖未经验证的临时卡位。版本变化或位置误差都可能让方案失效。",[25,104,105],{"id":105},"失误处理",[17,107,108],{},"被命中后立即检查护甲和照明。若灯灭或额外敌人进入战场，先撤到补给点恢复，不要在黑暗里继续追击。",[25,110,111],{"id":111},"常见失败原因",[29,113,114,117,120,123],{},[32,115,116],{},"只带一盏光源；",[32,118,119],{},"没清理附近生物就开战；",[32,121,122],{},"在狭窄角落贪刀；",[32,124,125],{},"地下背包里没有返程食物与备用装备。",[25,127,128],{"id":128},"击败后",[17,130,131],{},"整理迷宫战利品并带回安全点。下一步是继续修复远古科技、规划遗迹资源，或推进更深的暗影方向内容。",{"title":133,"searchDepth":134,"depth":134,"links":135},"",2,[136,137,138,144,148,149,150],{"id":27,"depth":134,"text":27},{"id":52,"depth":134,"text":52},{"id":63,"depth":134,"text":63,"children":139},[140,142,143],{"id":67,"depth":141,"text":67},3,{"id":73,"depth":141,"text":73},{"id":79,"depth":141,"text":79},{"id":90,"depth":134,"text":90,"children":145},[146,147],{"id":93,"depth":141,"text":93},{"id":99,"depth":141,"text":99},{"id":105,"depth":134,"text":105},{"id":111,"depth":134,"text":111},{"id":128,"depth":134,"text":128},null,"遗迹迷宫中的冲撞 Boss；清场、照明和可靠的卡位空间决定容错。",4,"Ancient Guardian","md",{},true,"\u002Fbosses\u002Fancient-guardian",[160,161,162,163,164],"caves-ruins","wolfgang","wx-78","lantern","football-helmet",{"title":5,"description":152},"遗迹探索","bosses\u002Fancient-guardian",[169,170,171,172],"洞穴","遗迹","路线 Boss","单人","2026-07-31","2026.07","QQ4KBWyHK-_r_npHyKAyH1a8d94dJi_l0HJYt8II4sg",1785483019334]