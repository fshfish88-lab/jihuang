[{"data":1,"prerenderedAt":158},["ShallowReactive",2],{"boss-klaus":3},{"id":4,"title":5,"aliases":6,"body":9,"category":133,"description":134,"difficulty":135,"english":136,"extension":137,"meta":138,"navigation":139,"path":140,"related":141,"seo":147,"stage":148,"stem":149,"tags":150,"updatedAt":155,"version":156,"__hash__":157},"bosses\u002Fbosses\u002Fklaus.md","克劳斯",[5,7,8],"klaus","袋子boss",{"type":10,"value":11,"toc":118},"minimark",[12,23,27,30,33,55,58,62,65,68,71,74,77,80,95,98,112,115],[13,14,15],"blockquote",{},[16,17,18,22],"p",{},[19,20,21],"strong",{},"一句话结论："," 克劳斯战更考验阶段纪律：不要误伤关键目标，不要在召唤和范围威胁同时出现时贪输出。",[24,25,26],"h2",{"id":26},"挑战前置",[16,28,29],{},"在冬季找到相关目标与赃物袋，准备钥匙后再开战。第一次尝试前，把场地周围的额外敌人和障碍清掉，并留出足够的跑动空间。",[24,31,32],{"id":32},"三档配置",[34,35,36,43,49],"ul",{},[37,38,39,42],"li",{},[19,40,41],{},"最低配置："," 可靠武器、多套护甲、恢复、保暖和照明。",[37,44,45,48],{},[19,46,47],{},"新手推荐："," 火腿棒、头盔轮换、足量饺子、暖石与备用营火材料。",[37,50,51,54],{},[19,52,53],{},"高效配置："," 战斗角色主输出，队友管理召唤物、补给与倒地救援。",[24,56,57],{"id":57},"战斗阶段",[59,60,61],"h3",{"id":61},"常规阶段",[16,63,64],{},"观察攻击前摇，在安全窗口输出。不要为了保持连续伤害站在范围威胁中心。",[59,66,67],{"id":67},"召唤压力",[16,69,70],{},"先确保队伍没有被不同目标拉散。召唤物与 Boss 同时施压时，把战场拉开，逐个恢复可控节奏。",[59,72,73],{"id":73},"后段爆发",[16,75,76],{},"护甲耐久和恢复库存往往在此时最危险。提前分组摆放补给，不要等全部装备破损才去寻找。",[24,78,79],{"id":79},"两种打法",[81,82,83,89],"ol",{},[37,84,85,88],{},[19,86,87],{},"单人稳妥："," 少贪刀、预留更大移动空间，把战斗时间换成稳定。",[37,90,91,94],{},[19,92,93],{},"多人分工："," 一人维持 Boss 朝向，其他人处理额外压力并在安全侧输出。",[24,96,97],{"id":97},"常见失败原因",[34,99,100,103,106,109],{},[37,101,102],{},"场地没有清理，意外引入更多敌人；",[37,104,105],{},"保暖和照明消耗被低估；",[37,107,108],{},"队伍围成一圈，Boss 朝向不断变化；",[37,110,111],{},"后段装备库存见底，却没有撤退重整。",[24,113,114],{"id":114},"掉落与下一步",[16,116,117],{},"战利品袋能提供大量资源，但不要把“开袋”当作世界终点。将收益投入遗迹探索、航海或下一轮季节准备。",{"title":119,"searchDepth":120,"depth":120,"links":121},"",2,[122,123,124,130,131,132],{"id":26,"depth":120,"text":26},{"id":32,"depth":120,"text":32},{"id":57,"depth":120,"text":57,"children":125},[126,128,129],{"id":61,"depth":127,"text":61},3,{"id":67,"depth":127,"text":67},{"id":73,"depth":127,"text":73},{"id":79,"depth":120,"text":79},{"id":97,"depth":120,"text":97},{"id":114,"depth":120,"text":114},null,"冬季战利品 Boss；先找无眼鹿与赃物袋，再按阶段处理召唤物。",4,"Klaus","md",{},true,"\u002Fbosses\u002Fklaus",[142,143,144,145,146],"first-winter","wigfrid","wolfgang","hambat","pierogi",{"title":5,"description":134},"稳定过冬后","bosses\u002Fklaus",[151,152,153,154],"地表","冬季","可选","多人","2026-07-31","2026.07","9Nj84o-3QxbbeHALChqjYY7m-ol6RYuvcCyUEa-1RX4",1785495330745]