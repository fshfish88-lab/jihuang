[{"data":1,"prerenderedAt":184},["ShallowReactive",2],{"boss-bee-queen":3},{"id":4,"title":5,"aliases":6,"body":9,"category":159,"description":160,"difficulty":161,"english":162,"extension":163,"meta":164,"navigation":165,"path":166,"related":167,"seo":173,"stage":174,"stem":175,"tags":176,"updatedAt":181,"version":182,"__hash__":183},"bosses\u002Fbosses\u002Fbee-queen.md","蜂后",[5,7,8],"bee queen","bq",{"type":10,"value":11,"toc":143},"minimark",[12,23,27,43,46,49,52,56,59,62,81,84,87,90,93,96,111,114,128,131],[13,14,15],"blockquote",{},[16,17,18,22],"p",{},[19,20,21],"strong",{},"一句话结论："," 蜂后不是“带够武器就能打”的 Boss；清杂、移动、恢复和阶段分工必须同时成立。",[24,25,26],"h2",{"id":26},"基本信息",[28,29,30,34,37,40],"ul",{},[31,32,33],"li",{},"出现位置：巨大蜂巢相关区域；",[31,35,36],{},"主要风险：大量召唤物、持续追击、团队阵型被打散；",[31,38,39],{},"是否主线必要：不是；",[31,41,42],{},"推荐人数：熟练单人可挑战，新手更适合多人分工。",[24,44,45],{"id":45},"挑战前置",[16,47,48],{},"稳定食物循环，准备大量护甲与恢复，并提前清理场地。队伍应明确：谁负责吸引、谁清理召唤物、谁主要输出、物资放在哪里。",[24,50,51],{"id":51},"三档配置",[53,54,55],"h3",{"id":55},"最低配置",[16,57,58],{},"不建议新手以最低配置尝试。至少要有多套护甲、可靠武器、持续恢复和可重复补给。",[53,60,61],{"id":61},"新手推荐",[16,63,64,65,70,71,75,76,80],{},"由",[66,67,69],"a",{"href":68},"\u002Fcharacters\u002Fwendy","温蒂","协助处理群体单位，其他角色维持阵型；准备大量",[66,72,74],{"href":73},"\u002Fwiki\u002Fpierogi","波兰水饺","和",[66,77,79],{"href":78},"\u002Fwiki\u002Ffootball-helmet","橄榄球头盔","。",[53,82,83],{"id":83},"高效配置",[16,85,86],{},"战斗角色集中安全输出，清杂角色减少场面压力，补给点按人分组，避免所有人抢同一堆物资。",[24,88,89],{"id":89},"阶段原则",[16,91,92],{},"蜂群压力低时再输出蜂后；场面失控时先恢复移动空间。被减速或围住后，不要继续站在原地交换伤害，优先脱离并重建阵型。",[24,94,95],{"id":95},"两种打法",[97,98,99,105],"ol",{},[31,100,101,104],{},[19,102,103],{},"多人分工："," 新手最推荐，清杂、输出和补给各有负责人。",[31,106,107,110],{},[19,108,109],{},"熟练走位："," 依赖对召唤节奏和移动空间的理解，不适合作为第一次大型 Boss 练习。",[24,112,113],{"id":113},"常见失败原因",[28,115,116,119,122,125],{},[31,117,118],{},"只准备高伤害武器，没有足够护甲和恢复；",[31,120,121],{},"所有人同时追 Boss，召唤物无人处理；",[31,123,124],{},"补给堆太集中，被战斗范围覆盖；",[31,126,127],{},"低状态仍坚持当前阶段，不主动重置节奏。",[24,129,130],{"id":130},"掉落与下一步",[16,132,133,134,138,139,80],{},"蜂后掉落可显著改善团队后续资源与战斗体验。胜利后可以挑战",[66,135,137],{"href":136},"\u002Fbosses\u002Fklaus","克劳斯","或把资源投入",[66,140,142],{"href":141},"\u002Fprogression\u002Fcaves-ruins","洞穴与遗迹线",{"title":144,"searchDepth":145,"depth":145,"links":146},"",2,[147,148,149,155,156,157,158],{"id":26,"depth":145,"text":26},{"id":45,"depth":145,"text":45},{"id":51,"depth":145,"text":51,"children":150},[151,153,154],{"id":55,"depth":152,"text":55},3,{"id":61,"depth":152,"text":61},{"id":83,"depth":152,"text":83},{"id":89,"depth":145,"text":89},{"id":95,"depth":145,"text":95},{"id":113,"depth":145,"text":113},{"id":130,"depth":145,"text":130},null,"高压群怪战，准备减速、护甲和持续恢复比追求爆发更重要。",5,"Bee Queen","md",{},true,"\u002Fbosses\u002Fbee-queen",[168,169,170,171,172],"wendy","wolfgang","wigfrid","pierogi","football-helmet",{"title":5,"description":160},"稳定基地后","bosses\u002Fbee-queen",[177,178,179,180],"地表","团队推荐","可选","群怪","2026-07-31","2026.07","-ho_FV_pRwuI465uw6Hn1589HUqGXWhXLn10lM6YJL0",1785495330735]